//@version=6
strategy("AKJ2.0 – Strategie (Backtest)", shorttitle = "AKJ2.0 S", overlay = true, initial_capital = 10000, currency = currency.USD, pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.cash_per_order, commission_value = 1, slippage = 2, margin_long = 100, margin_short = 100, use_bar_magnifier = true, process_orders_on_close = false)

// Backtest-Version des Indikators akj_setup_indikator.pine (nur Daily-Chart).
// Setup-Logik kommt aus der Library akj_lib.pine (wie im Indikator) – Regeländerungen dort, Tests in tests/akj_tests.pine.
import bBccdde/AKJ2/6 as akj
// Kommission (Default 1 $/Order) und Slippage (Default 2 Ticks) im Reiter „Eigenschaften“ einstellbar.
// Einschränkung: Die Earnings-Sperre wirkt nur für den nächsten Termin – im Backtest greift sie für
// vergangene Earnings NICHT (TradingView liefert vergangene Termine nicht im Voraus).

// ═══════════════════════════════════════════════════════════════════
// EINSTELLUNGEN
// ═══════════════════════════════════════════════════════════════════
G_TREND = "Regeln – Trend"
bbLen     = input.int(10, "BB Länge", minval = 1, group = G_TREND)
bbMult    = input.float(1.0, "BB Standardabweichung", minval = 0.1, step = 0.1, group = G_TREND)
wrLen      = input.int(4, "Williams %R Länge", minval = 1, group = G_TREND)   // Basis-Indikatoren (BB, %R) wie bei den TradingView-Standards beisammen
wrLongLvl  = input.float(-80.0, "%R Long: Close ≤", group = G_TREND)
wrShortLvl = input.float(-20.0, "%R Short: Close ≥", group = G_TREND)

G_SETUP = "Regeln – Setup & Entry"
enableLong  = input.bool(true, "Long-Setups", group = G_SETUP)
enableShort = input.bool(true, "Short-Setups", group = G_SETUP)
// Puffer (Issue #24, Handelsplan): bis zur Kurs-Schwelle fest X Ticks, darüber Y ‰ vom Kurs, auf den Tick aufgerundet.
bufTicks    = input.int(3, "Puffer: Ticks / Schwelle (Kurs) / ‰ darüber", minval = 0, group = G_SETUP, inline = "buf", tooltip = "Entry und Stop-Loss liegen je einen Puffer jenseits von Hoch bzw. Tief der Signalkerze. Bis zur Schwelle (Kurs): fester Puffer in Ticks. Darüber: Promille vom Kurs, auf den nächsten Tick aufgerundet (0,3 ‰: 500 $ → 0,15 $).")
bufThresh   = input.float(100.0, "", minval = 0.0, step = 10.0, group = G_SETUP, inline = "buf")
bufPermille = input.float(0.3, "", minval = 0.0, step = 0.1, group = G_SETUP, inline = "buf")
roundAvoid  = input.bool(true, "Glatte Zahlen meiden (Raster)", group = G_SETUP, inline = "round", tooltip = "Entry und Stop-Loss liegen mindestens einen Puffer jenseits glatter Kurse (Raster 0,50 = ganze und halbe Dollar, damit auch 5er und 10er). Läge das Level innerhalb eines Puffers vor einer Rasterstufe, wird es einen Puffer hinter die Stufe gelegt – der Abstand wird dann etwas größer.")
roundStep   = input.float(0.5, "", minval = 0.01, step = 0.5, group = G_SETUP, inline = "round")
expiryBars  = input.int(0, "Setup verfällt nach X Bars (0 = nie)", minval = 0, group = G_SETUP, tooltip = "Gezählt ab dem ersten Setup-Bar.")
riskFilter  = input.bool(true, "Risiko-Filter", group = G_SETUP, tooltip = "Risiko = |Entry − SL| / Entry. Außerhalb des Bereichs wird keine Order platziert.")
riskMin     = input.float(2.0, "Risiko min. / max. (%)", minval = 0.0, step = 0.1, group = G_SETUP, inline = "risk")
riskMax     = input.float(7.0, "", minval = 0.0, step = 0.1, group = G_SETUP, inline = "risk")

G_EARN = "Regeln – Earnings"
hideNearEarn = input.bool(true, "Keine Orders im Sperrfenster", group = G_EARN, tooltip = "Greift nur für den nächsten Earnings-Termin, nicht für vergangene (Backtest).")
earnDays     = input.int(8, "Sperrfenster (Kalendertage vor Earnings)", minval = 0, maxval = 21, group = G_EARN)

G_SEC = "Regeln – Sektor"
secFilter   = input.bool(true, "Nur handeln, wenn der Sektor-ETF im gleichen Trend ist (W und D)", group = G_SEC, tooltip = "Issue #16: Long nur, wenn der Sektor-ETF im Weekly UND Daily auf Kauf steht (2x Close über dem oberen BB, bis zum Gegentrigger); Short spiegelbildlich. Ein Setup des ETF ist nicht nötig. Geprüft mit dem Zustand für die nächste Kerze (wie der Trend der Aktie). Ohne bekannten Sektor-ETF werden mit aktivem Filter KEINE Trades eingegangen – dann unten „Sektor-ETF“ eintragen oder Filter aus.")
secOverride = input.symbol("", "Sektor-ETF (leer = automatisch aus dem TradingView-Sektor)", group = G_SEC, tooltip = "Leer: Select Sector SPDR aus dem TradingView-Sektor (Näherung, nur USD-Aktien). Hier kann ein anderer ETF oder Index eingetragen werden, z. B. SPY.")

G_FVG = "Regeln – Fair Value Gaps"
fvgFilter = input.bool(false, "FVG-Filter: keine Order bei FVG im Gewinnbereich", group = G_FVG, tooltip = "Wie im Indikator (Issue #18): Keine Order, wenn ein ungefülltes gegenläufiges FVG (Long: bärisch, Short: bullisch) den Bereich zwischen Entry und Ziel bei CRV 1:1 auch nur teilweise überlappt. Das Setup läuft intern weiter; sobald das FVG gefüllt ist, wird die Order wieder gesetzt. FVGs werden nur bei aktivem Filter berechnet.")
fvgFillMode = input.string("Komplett abgedeckt", "Gefüllt, wenn", options = ["Komplett abgedeckt", "Mitte berührt (Consequent Encroachment)"], group = G_FVG, tooltip = "Wann gilt ein FVG als geschlossen? Komplett abgedeckt: Der Füllbereich einer Folgekerze reicht bis zur fernen Kante der Lücke (bullisch: bis zur Unterkante). Mitte berührt: Es genügt, wenn der Füllbereich die 50-%-Marke der ursprünglichen Lücke erreicht (ICT „Consequent Encroachment“).")
fvgPartial  = input.bool(false, "Teilweise Füllung verkleinert das FVG", group = G_FVG, tooltip = "An: Jede Folgekerze, die in die Lücke hineinreicht, verkleinert sie auf den ungefüllten Rest. Aus: Die Lücke bleibt unverändert, bis sie nach der Regel oben geschlossen ist (üblich).")
fvgWicks    = input.bool(false, "Dochte zählen beim Füllen (sonst nur der Kerzenkörper)", group = G_FVG, tooltip = "An: Hoch und Tief der Folgekerzen füllen. Aus: Nur der Bereich zwischen Open und Close füllt (üblich). Die Lücke selbst entsteht immer aus Hoch und Tief der ersten und dritten Kerze.")
fvgUseD   = input.bool(true, "Daily (Rückschau in Kerzen)", group = G_FVG, inline = "fvgD")
fvgLbD    = input.int(500, "", minval = 1, maxval = 5000, group = G_FVG, inline = "fvgD")
fvgUseW   = input.bool(true, "Weekly (Rückschau in Kerzen)", group = G_FVG, inline = "fvgW")
fvgLbW    = input.int(520, "", minval = 1, maxval = 5000, group = G_FVG, inline = "fvgW")
fvgUseM   = input.bool(true, "Monthly (Rückschau in Kerzen)", group = G_FVG, inline = "fvgM")
fvgLbM    = input.int(240, "", minval = 1, maxval = 5000, group = G_FVG, inline = "fvgM")

G_BT = "Positionsgröße & Ausstieg"
maxDD        = input.float(2000.0, "Max. Drawdown ($)", minval = 1.0, step = 100.0, group = G_BT, tooltip = "Maximal akzeptierter Drawdown des Depots.")
riskPerTrade = input.float(1.0, "Risiko pro Trade (% vom Max. Drawdown)", minval = 0.01, step = 0.1, group = G_BT, tooltip = "Default: 1 % von 2000 $ = 20 $ Risiko pro Trade. Stückzahl = Risikobetrag / |Entry − SL|, abgerundet auf ganze Stück.")
exitMode     = input.string("Trailing BB-Mittelband", "Ausstieg", options = ["CRV 1:1 (komplett)", "Trailing BB-Mittelband"], group = G_BT, tooltip = "CRV 1:1: gesamte Position bei Ziel = Entry ± Risiko schließen. Trailing: bei CRV 1:1 SL auf Einstand, danach SL am BB-Mittelband nachziehen (nur in Gewinnrichtung).")
trailLongOnly = input.bool(true, "Trailing nur für Long (Short immer CRV 1:1)", group = G_BT)

G_RANGE = "Zeitraum"
startDate = input.time(timestamp("2020-01-01"), "Startdatum", group = G_RANGE)
endDate   = input.time(timestamp("2099-12-31"), "Enddatum", group = G_RANGE)

// ═══════════════════════════════════════════════════════════════════
// TREND (nur Daily-Chart: Weekly + Daily)
// ═══════════════════════════════════════════════════════════════════
isDaily = timeframe.isdaily and timeframe.multiplier == 1
inRange = time >= startDate and time <= endDate

[basis, upper, lower] = ta.bb(close, bbLen, bbMult)
wr = ta.wpr(wrLen)

// Weekly: EIN Abruf liefert den Zustand der letzten abgeschlossenen Woche ([1] + lookahead, kein Repainting),
// den Zustand inkl. laufender Woche und die Kerzen für Weekly-FVGs (wie htfData() im Indikator, Issue #21).
// Monthly wird nur für den FVG-Filter gebraucht und deshalb nur bei aktivem Filter abgerufen.
htfData() =>
    s = akj.bbTrendState(close, bbLen, bbMult)
    [s[1], s, high[1], low[1], high[3], low[3], time[3], time[1]]
htfReq(simple bool need, simple string tf) =>
    if need
        request.security(syminfo.tickerid, tf, htfData(), lookahead = barmerge.lookahead_on)
    else
        [int(na), int(na), float(na), float(na), float(na), float(na), int(na), int(na)]
[weeklyState, wStateNow, wH, wL, wH2, wL2, wT2, wT] = htfReq(true, "W")
[mS1, mS0, mH, mL, mH2, mL2, mT2, mT] = htfReq(fvgFilter and fvgUseM, "M")

// Regime auf dieser Kerze: gilt ab der Kerze nach der Trigger-Kerze (wie im Indikator).
dailyNext   = akj.bbTrendState(close, bbLen, bbMult)   // Zustand nach dem heutigen Close
dailyState  = dailyNext[1]
longTrend   = isDaily and weeklyState == 1  and dailyState == 1
shortTrend  = isDaily and weeklyState == -1 and dailyState == -1

// Regime für die NÄCHSTE Kerze (Orders werden zum Close für die nächste Kerze gesetzt):
// Daily = Zustand nach dem heutigen Close; Weekly = am Freitag der Zustand der heute endenden Woche.
weeklyNext  = dayofweek == dayofweek.friday ? wStateNow : weeklyState
longNext    = isDaily and weeklyNext == 1  and dailyNext == 1
shortNext   = isDaily and weeklyNext == -1 and dailyNext == -1

// ═══════════════════════════════════════════════════════════════════
// SEKTOR-TREND (Issue #16): Weekly- und Daily-Trend des Sektor-ETF, wie bei der Aktie für die NÄCHSTE Kerze
// (Daily nach dem heutigen Close, Weekly am Freitag der endenden Woche). Zwei Abrufe, nur bei aktivem Filter.
// ═══════════════════════════════════════════════════════════════════
// nz() gibt es nur für Zahlen – fehlende Sektor-/Industrie-Angaben (na) per Prüfung ersetzen.
secAuto = syminfo.currency == "USD" ? akj.sectorEtf(na(syminfo.sector) ? "" : syminfo.sector, na(syminfo.industry) ? "" : syminfo.industry) : "–"
secSym  = secOverride != "" ? secOverride : secAuto == "–" ? "" : secAuto
secName = secSym == "" ? "–" : str.contains(secSym, ":") ? array.last(str.split(secSym, ":")) : secSym
secData() =>
    s = akj.bbTrendState(close, bbLen, bbMult)
    [s[1], s]
// need muss simple sein (sonst Warnung „should be called on each calculation“) – secSym kommt aus der Library und ist
// deshalb series. Darum entscheidet nur der Schalter; ohne bekannten ETF wird das eigene Symbol abgefragt (Ergebnis ungenutzt).
secReq(simple bool need, string sym, simple string tf) =>
    if need
        request.security(sym, tf, secData(), lookahead = barmerge.lookahead_on)
    else
        [int(na), int(na)]
secOn    = secFilter and secSym != ""
secReqSym = secSym == "" ? syminfo.tickerid : secSym
[secW1, secW0] = secReq(secFilter, secReqSym, "W")
[secD1, secD0] = secReq(secFilter, secReqSym, "D")
secWNext = dayofweek == dayofweek.friday ? secW0 : secW1
secNext  = not secOn ? 0 : secWNext == 1 and secD0 == 1 ? 1 : secWNext == -1 and secD0 == -1 ? -1 : 0   // für die nächste Kerze
secTrend = not secOn ? int(na) : secW1 == 1 and secD1 == 1 ? 1 : secW1 == -1 and secD1 == -1 ? -1 : 0  // auf dieser Kerze (Anzeige)

// ═══════════════════════════════════════════════════════════════════
// EARNINGS (nur nächster Termin bekannt)
// ═══════════════════════════════════════════════════════════════════
DAY_MS        = 86400000
earnWinMs     = earnDays * DAY_MS
nextEarn      = earnings.future_time
// Vergleich nach Kalendertagen wie im Indikator (Issue #1: Zahlen vor Börsenbeginn).
earnDay       = akj.earnDay(int(nextEarn))
barDay        = akj.dayOf(time, syminfo.timezone)
nextDayShift  = (dayofweek == dayofweek.friday ? 3 : 1) * DAY_MS
earnBlock     = hideNearEarn and akj.inEarnWin(barDay, barDay, earnDay, earnWinMs)
earnBlockNext = hideNearEarn and akj.inEarnWin(barDay + nextDayShift, barDay + nextDayShift, earnDay, earnWinMs)

// ═══════════════════════════════════════════════════════════════════
// SETUP-LOGIK (Library akj.setupStep wie im Indikator; während eines offenen Trades keine Setups)
// Unterschied zum alten Inline-Code: Ein Setup entsteht bzw. bleibt nicht mehr auf einer Kerze, deren Close der
// Gegentrigger ist (longNext/shortNext). Auf die Orders hat das keinen Einfluss – dafür galt schon vorher trendNext.
// ═══════════════════════════════════════════════════════════════════
rules = akj.Rules.new(enableLong, enableShort, wrLongLvl, wrShortLvl, expiryBars, syminfo.mintick, bufTicks, bufThresh, bufPermille, roundAvoid, roundStep)
var akj.Setup st = akj.Setup.new()
posDir = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
if posDir != 0
    st := akj.Setup.new()
st := akj.setupStep(st, rules, open, high, low, close, wr, bar_index, barstate.isconfirmed, posDir == 0 and isDaily and inRange, longTrend, shortTrend, longNext, shortNext, earnBlock)
setupDir   = st.dir
setupStart = st.startBar
entryLvl   = st.entry
slLvl      = st.sl

riskPct = setupDir != 0 ? akj.riskPct(entryLvl, slLvl) : na
riskOk  = not riskFilter or (riskPct >= riskMin and riskPct <= riskMax)

// ═══════════════════════════════════════════════════════════════════
// FAIR VALUE GAPS (Issue #18, wie im Indikator im Daily-Chart): Daily aus den Chart-Kerzen, Weekly und Monthly
// aus den Abrufen ([1] + lookahead = zuletzt abgeschlossene Kerze). Gefüllt wird mit den Chart-Kerzen nach den
// Regeln aus den Einstellungen (Issue #36). Nur bei aktivem Filter berechnet – sonst ohne Wirkung.
// ═══════════════════════════════════════════════════════════════════
fvgOn = fvgFilter and isDaily
wNew  = not na(wT) and (na(wT[1]) or wT != wT[1])     // neue Weekly-Kerze abgeschlossen
mNew  = not na(mT) and (na(mT[1]) or mT != mT[1])     // neue Monthly-Kerze abgeschlossen
var fvgBull  = array.new<akj.Fvg>()   // bullisch, absteigend nach top
var fvgBear  = array.new<akj.Fvg>()   // bärisch, aufsteigend nach bot
var fvgQD    = array.new<akj.Fvg>()   // Ablauf-Warteschlangen je TF (Entstehungsreihenfolge)
var fvgQW    = array.new<akj.Fvg>()
var fvgQM    = array.new<akj.Fvg>()
var int fvgAlive = 0
var int wCnt = 0
var int mCnt = 0
FVG_MAX = 1500   // ab dieser Listenlänge erledigte Einträge aufräumen
if fvgOn and barstate.isconfirmed
    if wNew
        wCnt += 1
        if fvgUseW and not na(wH2)
            fvgAlive += akj.fvgAdd(fvgBull, fvgBear, fvgQW, 2, wH, wL, wH2, wL2, wT2, wCnt)
    if mNew
        mCnt += 1
        if fvgUseM and not na(mH2)
            fvgAlive += akj.fvgAdd(fvgBull, fvgBear, fvgQM, 3, mH, mL, mH2, mL2, mT2, mCnt)
    fvgAlive -= akj.fvgExpire(fvgQD, bar_index, fvgLbD)
    fvgAlive -= akj.fvgExpire(fvgQW, wCnt, fvgLbW)
    fvgAlive -= akj.fvgExpire(fvgQM, mCnt, fvgLbM)
    fillLo = fvgWicks ? low : math.min(open, close)
    fillHi = fvgWicks ? high : math.max(open, close)
    fvgCe  = fvgFillMode != "Komplett abgedeckt"
    fvgAlive -= akj.fvgFill(fvgBull, true, fillLo, fillHi, fvgPartial, fvgCe)
    fvgAlive -= akj.fvgFill(fvgBear, false, fillLo, fillHi, fvgPartial, fvgCe)
    if fvgUseD and bar_index >= 2
        fvgAlive += akj.fvgAdd(fvgBull, fvgBear, fvgQD, 1, high, low, high[2], low[2], time[2], bar_index)
    if fvgBull.size() > FVG_MAX
        akj.fvgCompact(fvgBull)
    if fvgBear.size() > FVG_MAX
        akj.fvgCompact(fvgBear)
// Gegenläufiges FVG im Gewinnbereich [Entry, Ziel 1:1] des offenen Setups? Geprüft zum Close, also mit dem
// Stand für die nächste Kerze (Order-Entscheidung unten).
fvgInZone = fvgOn and setupDir != 0 and fvgAlive > 0 and akj.fvgHit(fvgBull, fvgBear, setupDir, entryLvl, slLvl)
fvgOk     = not fvgInZone

// ═══════════════════════════════════════════════════════════════════
// ORDERS
// Zum Close jeder Kerze wird entschieden, welche Orders für die nächste Kerze gelten.
// ═══════════════════════════════════════════════════════════════════
ID_L  = "Long"
ID_S  = "Short"
riskAmt = maxDD * riskPerTrade / 100.0

var float trSl     = na      // aktueller Stop des (geplanten/offenen) Trades
var float trTp1    = na      // Ziel bei CRV 1:1
var bool  trTrail  = false   // Trailing-Modus für diesen Trade?
var bool  trTp1Hit = false

// 1) Flat: Stop-Order für das offene Setup setzen/nachziehen oder löschen.
if posDir == 0
    trTp1Hit := false
    expiryNext = setupDir != 0 and akj.setupExpired(bar_index + 1, setupStart, expiryBars)
    trendNext  = setupDir == 1 ? longNext : setupDir == -1 ? shortNext : false
    qty        = setupDir != 0 ? math.floor(riskAmt / math.abs(entryLvl - slLvl)) : 0
    secOk      = not secFilter or secNext == setupDir   // Sektor-Filter (Issue #16); ohne ETF: secNext = 0 → keine Orders
    orderOk    = setupDir != 0 and riskOk and fvgOk and trendNext and not earnBlockNext and not expiryNext and secOk and qty >= 1
    if orderOk
        id      = setupDir == 1 ? ID_L : ID_S
        trSl    := slLvl
        trTp1   := entryLvl + setupDir * math.abs(entryLvl - slLvl)
        trTrail := exitMode == "Trailing BB-Mittelband" and (setupDir == 1 or not trailLongOnly)
        strategy.cancel(setupDir == 1 ? ID_S : ID_L)
        strategy.entry(id, setupDir == 1 ? strategy.long : strategy.short, qty = qty, stop = entryLvl)
        // Exit-Order wird mit der Entry-Order aktiv – greift also schon auf der Einstiegskerze.
        strategy.exit("Exit " + id, id, stop = trSl, limit = trTrail ? na : trTp1)
    else
        strategy.cancel(ID_L)
        strategy.cancel(ID_S)

// 2) Im Trade (nur Trailing-Modus): ab CRV 1:1 SL auf Einstand, danach am BB-Mittelband nachziehen.
else if trTrail
    if not trTp1Hit and (posDir == 1 ? high >= trTp1 : low <= trTp1)
        trTp1Hit := true
    if trTp1Hit
        be   = strategy.position_avg_price
        trSl := posDir == 1 ? math.max(trSl, be, basis) : math.min(trSl, be, basis)
    id = posDir == 1 ? ID_L : ID_S
    strategy.exit("Exit " + id, id, stop = trSl)

// ═══════════════════════════════════════════════════════════════════
// DARSTELLUNG (schlank – Details liefert der Strategietester)
// ═══════════════════════════════════════════════════════════════════
plot(basis, "BB Mid", color.new(color.gray, 20), 1)
plot(secTrend, "Sektor-Trend (1 / -1 / 0)", display = display.data_window, editable = false)
plot(fvgOn ? fvgAlive : na, "Offene FVGs (Anzahl)", display = display.data_window, editable = false)
plot(fvgOn and setupDir != 0 ? (fvgInZone ? 1 : 0) : na, "FVG im Gewinnbereich (1 / 0)", display = display.data_window, editable = false)
// Hinweis, wenn der Sektor-Filter aktiv ist, aber kein Sektor-ETF bekannt – dann gibt es keine Trades.
// Die Bedingung hängt nur von Symbol und Inputs ab, daher einmal auf der ersten Kerze zeichnen (kein barstate.islast:
// Strategien ohne calc_on_every_tick warnen davor, Tabellen bleiben ohnehin bestehen).
var table secTbl = table.new(position.middle_center, 1, 1, bgcolor = #E65100, frame_color = #E65100, frame_width = 4, border_width = 0)
if barstate.isfirst and secFilter and secSym == ""
    table.cell(secTbl, 0, 0, "⚠ Sektor-Filter aktiv, aber kein Sektor-ETF bekannt – keine Trades.\nETF im Input „Sektor-ETF“ eintragen oder Filter abschalten.", text_color = color.white, text_size = size.large, text_formatting = text.format_bold)
plot(posDir == 0 and setupDir != 0 and riskOk and fvgOk ? entryLvl : na, "Entry-Order", color.blue, 2, plot.style_linebr)
plot(posDir != 0 ? trSl : na, "Stop", color.red, 1, plot.style_linebr)
plot(posDir != 0 and not trTp1Hit ? trTp1 : na, "Ziel CRV 1:1", color.green, 1, plot.style_linebr)
