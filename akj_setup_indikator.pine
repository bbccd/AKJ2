//@version=6
indicator("AKJ2.0 – Trend & Setup Detector", shorttitle = "AKJ2.0", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ═══════════════════════════════════════════════════════════════════
// EINSTELLUNGEN
// ═══════════════════════════════════════════════════════════════════
G_RANGE = "Zeitraum"
startDate = input.time(timestamp("2020-01-01"), "Startdatum", group = G_RANGE)
endDate   = input.time(timestamp("2099-12-31"), "Enddatum", group = G_RANGE)

G_TREND = "Trend"
htfInput  = input.string("Auto", "Übergeordneter Timeframe", options = ["Auto", "D", "W", "M"], group = G_TREND, tooltip = "Auto: Daily-Chart → Weekly, Weekly-Chart → Monthly, Intraday → Daily.")
bbLen     = input.int(10, "BB Länge", minval = 1, group = G_TREND)
bbMult    = input.float(1.0, "BB Standardabweichung", minval = 0.1, step = 0.1, group = G_TREND)
showBB    = input.bool(true, "Bollinger-Bänder anzeigen", group = G_TREND)
showBg    = input.bool(true, "Weekly-Trend als Hintergrund", group = G_TREND)
showWLines = input.bool(true, "Weekly-Trendstart (Linie + Label)", group = G_TREND)
show2ndTrend = input.bool(true, "Trendstart des 2. Timeframes (D bzw. M)", group = G_TREND)

G_SETUP = "Setup & Entry"
enableLong  = input.bool(true, "Long", group = G_SETUP, inline = "dir")
enableShort = input.bool(true, "Short", group = G_SETUP, inline = "dir")
wrLen       = input.int(4, "Williams %R Länge", minval = 1, group = G_SETUP)
wrLongLvl   = input.float(-80.0, "%R Long: Close ≤", group = G_SETUP)
wrShortLvl  = input.float(-20.0, "%R Short: Close ≥", group = G_SETUP)
entryTicks  = input.int(2, "Entry-Puffer (Ticks)", minval = 0, group = G_SETUP)
slTicks     = input.int(2, "Stop-Loss-Puffer (Ticks)", minval = 0, group = G_SETUP)
bufPermille = input.float(0.0, "Mindest-Puffer (‰ vom Kurs, 0 = aus)", minval = 0.0, step = 0.1, group = G_SETUP, tooltip = "Puffer = größerer Wert aus Ticks und Promille. Für teure Aktien gedacht.")
expiryBars  = input.int(0, "Setup verfällt nach X Bars (0 = nie)", minval = 0, group = G_SETUP, tooltip = "Platzhalter fürs Refinement. Gezählt ab dem ersten Setup-Bar.")

G_TRADE = "Trade-Management"
tp1Crv    = input.float(1.0, "Ziel 1 (CRV), 50 % schließen", minval = 0.1, step = 0.1, group = G_TRADE)
trailMode = input.string("Kein Trailing", "Rest nach Ziel 1", options = ["Kein Trailing", "BB-Mittelband"], group = G_TRADE, tooltip = "Nach Ziel 1 steht der Stop immer mind. auf Einstand.")

G_EARN = "Earnings"
showEarn     = input.bool(true, "Earnings anzeigen", group = G_EARN)
hideNearEarn = input.bool(true, "Signale vor Earnings ausblenden", group = G_EARN)
earnDays     = input.int(8, "Sperrfenster (Kalendertage vor Earnings)", minval = 0, group = G_EARN)

showTable = input.bool(true, "Status-Tabelle anzeigen", group = "Anzeige")

// ═══════════════════════════════════════════════════════════════════
// FUNKTIONEN
// ═══════════════════════════════════════════════════════════════════
// Latched Trend: 1 = Kauf (2x Close > oberes BB), -1 = Verkauf (2x Close < unteres BB).
// Wechselt nur, wenn der Trigger in die Gegenrichtung kommt.
bbTrendState(simple int len, simple float mult) =>
    [mid, up, lo] = ta.bb(close, len, mult)
    var int state = 0
    if close > up and close[1] > up[1]
        state := 1
    else if close < lo and close[1] < lo[1]
        state := -1
    state

// Puffer in Preiseinheiten: mindestens X Ticks, optional mindestens Y Promille vom Kurs.
priceBuffer(float price, int ticks) =>
    math.max(ticks * syminfo.mintick, price * bufPermille / 1000.0)

// Hook fürs Refinement: Wann verfällt ein offenes Setup (Stop-Order noch nicht ausgelöst)?
setupExpired(int startBar) =>
    expiryBars > 0 and bar_index - startBar >= expiryBars

trendTxt(int s) => s == 1 ? "UP ▲" : s == -1 ? "DOWN ▼" : "–"
trendCol(int s) => s == 1 ? color.green : s == -1 ? color.red : color.gray

// ═══════════════════════════════════════════════════════════════════
// TIMEFRAMES (automatische Erkennung)
// Daily-Chart:  Weekly = übergeordneter Trend, Daily = Trade-Timeframe
// Weekly-Chart: Monthly = übergeordneter Trend, Weekly = Trade-Timeframe
// ═══════════════════════════════════════════════════════════════════
autoHtf = timeframe.isintraday ? "D" : timeframe.isdaily ? "W" : timeframe.isweekly ? "M" : "12M"
htfTf   = htfInput == "Auto" ? autoHtf : htfInput
tfValid = timeframe.in_seconds(htfTf) > timeframe.in_seconds()
inRange = time >= startDate and time <= endDate

// ═══════════════════════════════════════════════════════════════════
// INDIKATOREN & TREND
// ═══════════════════════════════════════════════════════════════════
[basis, upper, lower] = ta.bb(close, bbLen, bbMult)
wr = ta.wpr(wrLen)

// Höhere Timeframes ohne Repainting: nur abgeschlossene Kerzen zählen.
htfState  = request.security(syminfo.tickerid, htfTf, bbTrendState(bbLen, bbMult)[1], lookahead = barmerge.lookahead_on)
wReqState = request.security(syminfo.tickerid, "W", bbTrendState(bbLen, bbMult)[1], lookahead = barmerge.lookahead_on)
ltfState  = bbTrendState(bbLen, bbMult)

// Weekly-Trend (Hauptdarstellung): auf dem Weekly-Chart direkt, sonst aus dem Weekly angefragt.
weeklyState = timeframe.isweekly ? ltfState : wReqState
// Zweiter relevanter Timeframe: auf dem Weekly-Chart der Monat, sonst der Chart-Timeframe (Daily).
secState  = timeframe.isweekly ? htfState : ltfState
secTfName = timeframe.isweekly ? htfTf : timeframe.period

longTrend  = tfValid and htfState == 1 and ltfState == 1
shortTrend = tfValid and htfState == -1 and ltfState == -1

// ═══════════════════════════════════════════════════════════════════
// EARNINGS
// ═══════════════════════════════════════════════════════════════════
nextEarn   = earnings.future_time
daysToEarn = na(nextEarn) ? na : (nextEarn - time) / 86400000.0
earnSoon   = not na(daysToEarn) and daysToEarn >= 0 and daysToEarn <= earnDays
earnBlock  = hideNearEarn and earnSoon
pastEarn   = request.earnings(syminfo.tickerid, earnings.actual, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

// ═══════════════════════════════════════════════════════════════════
// SETUP- & TRADE-LOGIK
// ═══════════════════════════════════════════════════════════════════
var int   phase      = 0     // 0 = kein Setup, 1 = Stop-Order wartet, 2 = im Trade
var int   dir        = 0     // 1 = long, -1 = short
var int   setupStart = na
var float entryLvl   = na
var float slLvl      = na
var float tp1Lvl     = na
var float fillPx     = na
var float initRisk   = na
var float exitPx     = na
var float exitR      = na
var bool  tp1Hit     = false

bool evNewSetup  = false
bool evMoveSetup = false
bool evCancel    = false
bool evFill      = false
bool evTp1       = false
bool evExit      = false

// 1) Offener Trade: Stop prüfen (konservativ zuerst), dann Ziel 1, dann Trailing.
if phase == 2
    stopHit = dir == 1 ? low <= slLvl : high >= slLvl
    if stopHit
        exitPx := dir == 1 ? math.min(open, slLvl) : math.max(open, slLvl)
        rRest  = (exitPx - fillPx) * dir / initRisk
        exitR  := tp1Hit ? 0.5 * tp1Crv + 0.5 * rRest : rRest
        evExit := true
        phase  := 0
    else
        if not tp1Hit and (dir == 1 ? high >= tp1Lvl : low <= tp1Lvl)
            tp1Hit := true
            evTp1  := true
            slLvl  := fillPx
        if tp1Hit and trailMode == "BB-Mittelband"
            slLvl := dir == 1 ? math.max(slLvl, basis) : math.min(slLvl, basis)

// 2) Wartende Stop-Order: zuerst Auslösung prüfen (Order war während des Bars aktiv),
//    danach Abbruch-Bedingungen zum Bar-Schluss. Gaps ohne Auslösung werden ignoriert.
else if phase == 1
    filled = dir == 1 ? high >= entryLvl : low <= entryLvl
    if filled
        fillPx   := dir == 1 ? math.max(open, entryLvl) : math.min(open, entryLvl)
        initRisk := math.abs(fillPx - slLvl)
        tp1Lvl   := fillPx + dir * initRisk * tp1Crv
        tp1Hit   := false
        phase    := 2
        evFill   := true
    else
        trendLost = dir == 1 ? not longTrend : not shortTrend
        if trendLost or earnBlock or setupExpired(setupStart)
            phase    := 0
            evCancel := true

// 3) Neues Setup bzw. Nachziehen: rote (Long) / grüne (Short) Kerze mit %R-Close im Extrembereich.
//    Erfüllen mehrere Bars in Folge das Kriterium, gilt immer der aktuellste.
longSig  = inRange and enableLong  and longTrend  and close < open and wr <= wrLongLvl  and not earnBlock
shortSig = inRange and enableShort and shortTrend and close > open and wr >= wrShortLvl and not earnBlock

if barstate.isconfirmed and phase != 2 and not evExit
    sigDir = longSig ? 1 : shortSig ? -1 : 0
    if sigDir != 0
        if phase == 1 and dir == sigDir
            evMoveSetup := true
        else
            evNewSetup := true
            setupStart := bar_index
        dir      := sigDir
        phase    := 1
        entryLvl := math.round_to_mintick(sigDir == 1 ? high + priceBuffer(high, entryTicks) : low - priceBuffer(low, entryTicks))
        slLvl    := math.round_to_mintick(sigDir == 1 ? low - priceBuffer(low, slTicks) : high + priceBuffer(high, slTicks))

// ═══════════════════════════════════════════════════════════════════
// DARSTELLUNG – Bollinger-Bänder & Weekly-Trend
// ═══════════════════════════════════════════════════════════════════
plot(showBB ? basis : na, "BB Mid",   color.new(color.gray, 20), 1)
plot(showBB ? upper : na, "BB Upper", color.new(color.blue, 40), 1)
plot(showBB ? lower : na, "BB Lower", color.new(color.red, 40), 1)

bgcolor(showBg and weeklyState == 1  ? color.new(color.green, 75)  : na, title = "Weekly Uptrend Zone")
bgcolor(showBg and weeklyState == -1 ? color.new(color.orange, 75) : na, title = "Weekly Downtrend Zone")

// Trendstart nur beim Wechsel in den Zustand (Rising Edge)
weeklyUpEdge   = weeklyState == 1  and weeklyState[1] != 1
weeklyDownEdge = weeklyState == -1 and weeklyState[1] != -1

if showWLines and inRange and weeklyUpEdge
    line.new(bar_index, low, bar_index, high, color = color.green, width = 2, extend = extend.both)
    label.new(bar_index, high, "UP", color = color.green, textcolor = color.white, size = size.small, style = label.style_label_down)

if showWLines and inRange and weeklyDownEdge
    line.new(bar_index, low, bar_index, high, color = color.red, width = 2, extend = extend.both)
    label.new(bar_index, low, "DOWN", color = color.red, textcolor = color.white, size = size.small, style = label.style_label_up)

// Trendstart des 2. Timeframes (Daily auf dem Daily-Chart, Monthly auf dem Weekly-Chart)
secUpEdge   = secState == 1  and secState[1] != 1
secDownEdge = secState == -1 and secState[1] != -1

if show2ndTrend and inRange and tfValid and secUpEdge
    label.new(bar_index, high, secTfName + " ▲", color = color.new(color.green, 40), textcolor = color.white, size = size.tiny, style = label.style_label_down)

if show2ndTrend and inRange and tfValid and secDownEdge
    label.new(bar_index, low, secTfName + " ▼", color = color.new(color.red, 40), textcolor = color.white, size = size.tiny, style = label.style_label_up)

// ═══════════════════════════════════════════════════════════════════
// DARSTELLUNG – Setups & Trades
// ═══════════════════════════════════════════════════════════════════
plot(phase == 1 ? entryLvl : na, "Stop-Order", color.blue, 2, plot.style_linebr)
plot(phase != 0 ? slLvl : na, "Stop-Loss", color.red, 1, plot.style_linebr)
plot(phase == 2 ? fillPx : na, "Einstieg", color.new(color.blue, 40), 1, plot.style_linebr)
plot(phase == 2 and not tp1Hit ? tp1Lvl : na, "Ziel 1", color.green, 1, plot.style_linebr)

plotshape(evNewSetup and dir == 1, "Long-Setup", shape.triangleup, location.belowbar, color.green, size = size.small)
plotshape(evMoveSetup and dir == 1, "Long-Setup nachgezogen", shape.circle, location.belowbar, color.green, size = size.tiny)
plotshape(evNewSetup and dir == -1, "Short-Setup", shape.triangledown, location.abovebar, color.red, size = size.small)
plotshape(evMoveSetup and dir == -1, "Short-Setup nachgezogen", shape.circle, location.abovebar, color.red, size = size.tiny)
plotshape(evCancel, "Setup abgebrochen", shape.xcross, location.abovebar, color.gray, size = size.tiny)
plotshape(evTp1, "Ziel 1 erreicht", shape.flag, location.abovebar, color.green, size = size.tiny)
plotshape(showEarn and not na(pastEarn), "Earnings", shape.diamond, location.bottom, color.orange, size = size.tiny, text = "E")

if evFill
    txt = (dir == 1 ? "LONG" : "SHORT") + "\nEntry " + str.tostring(fillPx, format.mintick) + "\nSL " + str.tostring(slLvl, format.mintick) + "\nZiel 1 " + str.tostring(tp1Lvl, format.mintick)
    label.new(bar_index, dir == 1 ? low : high, txt, style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? color.green : color.red, textcolor = color.white, size = size.small)

if evExit
    label.new(bar_index, dir == 1 ? low : high, "Exit " + str.tostring(exitR, "+0.0;-0.0") + "R", style = dir == 1 ? label.style_label_up : label.style_label_down, color = exitR >= 0 ? color.new(color.green, 30) : color.new(color.red, 30), textcolor = color.white, size = size.tiny)

// Nächste Earnings als Marke in der Zukunft
var label earnLbl = na
if barstate.islast and showEarn and not na(nextEarn)
    label.delete(earnLbl)
    earnLbl := label.new(int(nextEarn), high, "Earnings\n" + str.format_time(int(nextEarn), "dd.MM.yyyy", syminfo.timezone), xloc = xloc.bar_time, style = label.style_label_down, color = color.orange, textcolor = color.black, size = size.small)

// ═══════════════════════════════════════════════════════════════════
// STATUS-TABELLE
// ═══════════════════════════════════════════════════════════════════
var table tbl = table.new(position.top_right, 2, 7, bgcolor = color.new(color.gray, 85), border_width = 1)
if showTable and barstate.islast
    dirTxt   = dir == 1 ? "Long" : "Short"
    phaseTxt = phase == 0 ? "Kein Setup" : phase == 1 ? dirTxt + " Stop-Order" : dirTxt + (tp1Hit ? " im Trade (Ziel 1 ✓)" : " im Trade")
    lvlTxt   = phase == 1 ? str.tostring(entryLvl, format.mintick) + " / SL " + str.tostring(slLvl, format.mintick) : phase == 2 ? str.tostring(fillPx, format.mintick) + " / SL " + str.tostring(slLvl, format.mintick) : "–"
    earnTxt  = na(nextEarn) ? "keine Daten" : str.format_time(int(nextEarn), "dd.MM.yyyy", syminfo.timezone) + " (" + str.tostring(math.ceil(daysToEarn)) + " T)"
    table.cell(tbl, 0, 0, "Trend " + htfTf, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 0, trendTxt(htfState), text_color = trendCol(htfState), text_size = size.small)
    table.cell(tbl, 0, 1, "Trend " + timeframe.period, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 1, trendTxt(ltfState), text_color = trendCol(ltfState), text_size = size.small)
    table.cell(tbl, 0, 2, "Williams %R", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 2, str.tostring(wr, "0.0"), text_color = wr <= wrLongLvl ? color.green : wr >= wrShortLvl ? color.red : chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 3, "Status", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 3, phaseTxt, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 4, "Entry / SL", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 4, lvlTxt, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 5, "Earnings", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 5, earnTxt, text_color = earnSoon ? color.orange : chart.fg_color, text_size = size.small)
    if not tfValid
        table.cell(tbl, 0, 6, "⚠", text_color = color.orange, text_size = size.small)
        table.cell(tbl, 1, 6, "Übergeordneter TF muss größer als Chart-TF sein", text_color = color.orange, text_size = size.small)

// ═══════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════
alertcondition(weeklyUpEdge, "Weekly UP", "{{ticker}}: Weekly-Trend UP")
alertcondition(weeklyDownEdge, "Weekly DOWN", "{{ticker}}: Weekly-Trend DOWN")
alertcondition((evNewSetup or evMoveSetup) and dir == 1, "Long-Setup", "{{ticker}}: Long-Setup – Stop-Buy gesetzt/nachgezogen")
alertcondition((evNewSetup or evMoveSetup) and dir == -1, "Short-Setup", "{{ticker}}: Short-Setup – Stop-Sell gesetzt/nachgezogen")
alertcondition(evFill and dir == 1, "Long-Einstieg", "{{ticker}}: Long-Einstieg ausgelöst")
alertcondition(evFill and dir == -1, "Short-Einstieg", "{{ticker}}: Short-Einstieg ausgelöst")
alertcondition(evTp1, "Ziel 1 erreicht", "{{ticker}}: Ziel 1 erreicht – 50 % schließen, Stop auf Einstand")
alertcondition(evExit, "Trade beendet", "{{ticker}}: Stop ausgelöst – Trade beendet")
