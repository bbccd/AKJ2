//@version=6
indicator("AKJ2.0 – Trend & Setup Detector", shorttitle = "AKJ2.0", overlay = true, max_labels_count = 500)

// Zweck: Aktien schnell auf mögliche Setups scannen. Bewusst kein Trade-Management und
// keine Entry-/Exit-Marker – das kommt später in die strategy()-Version.

// ═══════════════════════════════════════════════════════════════════
// EINSTELLUNGEN
// ═══════════════════════════════════════════════════════════════════
G_RANGE = "Zeitraum"
startDate = input.time(timestamp("2020-01-01"), "Startdatum", group = G_RANGE)
endDate   = input.time(timestamp("2099-12-31"), "Enddatum", group = G_RANGE)

G_TREND = "Trend"
bbLen     = input.int(10, "BB Länge", minval = 1, group = G_TREND)
bbMult    = input.float(1.0, "BB Standardabweichung", minval = 0.1, step = 0.1, group = G_TREND)
showBB    = input.bool(true, "Bollinger-Bänder anzeigen", group = G_TREND)
bgLongCol  = input.color(#1FBFB840, "Farbe Long-Hintergrund", group = G_TREND, inline = "bgcol")
bgShortCol = input.color(#F0629240, "Short", group = G_TREND, inline = "bgcol")
bgMode    = input.string("Trigger (W + D)", "Hintergrund", options = ["Trigger (W + D)", "Weekly-Trend", "Aus"], group = G_TREND, tooltip = "Trigger: im Daily-Chart nur gefärbt, wenn Weekly und Daily beide Kauf (Long-Farbe) bzw. beide Verkauf (Short-Farbe) sind, sonst kein Hintergrund. Im Weekly-Chart zeigt er den Weekly-Trigger. Weekly-Trend: nur der Weekly-Trend wie im alten AKJ2.")

G_SETUP = "Setup & Entry"
enableLong  = input.bool(true, "Long", group = G_SETUP, inline = "dir")
enableShort = input.bool(true, "Short", group = G_SETUP, inline = "dir")
wrLen       = input.int(4, "Williams %R Länge", minval = 1, group = G_SETUP)
wrLongLvl   = input.float(-80.0, "%R Long: Close ≤", group = G_SETUP)
wrShortLvl  = input.float(-20.0, "%R Short: Close ≥", group = G_SETUP)
entryTicks  = input.int(2, "Entry-Puffer (Ticks)", minval = 0, group = G_SETUP)
slTicks     = input.int(2, "Stop-Loss-Puffer (Ticks)", minval = 0, group = G_SETUP)
bufPermille = input.float(0.0, "Mindest-Puffer (‰ vom Kurs, 0 = aus)", minval = 0.0, step = 0.1, group = G_SETUP, tooltip = "Puffer = größerer Wert aus Ticks und Promille. Für teure Aktien gedacht.")
expiryBars  = input.int(0, "Setup verfällt nach X Bars (0 = nie)", minval = 0, group = G_SETUP, tooltip = "Platzhalter fürs Refinement. Gezählt ab dem ersten Setup-Bar.")

G_EARN = "Earnings"
showEarnBg   = input.bool(true, "Sperrfenster grau hinterlegen", group = G_EARN, tooltip = "Grauer Hintergrund vom Beginn des Sperrfensters bis einschließlich Earnings-Tag bzw. -Woche. Vergangene Termine: TradingView liefert sie bei Veröffentlichung nach Börsenschluss erst am Folgetag – dann ist dieser Tag mit grau.")
hideNearEarn = input.bool(true, "Keine Signale im Sperrfenster", group = G_EARN)
earnDays     = input.int(8, "Sperrfenster (Kalendertage vor Earnings)", minval = 0, maxval = 21, group = G_EARN)

G_SHOW = "Anzeige"
sigSizeIn   = input.string("Normal", "Größe Signal-Marker", options = ["Klein", "Normal", "Groß"], group = G_SHOW)
hlCurrent   = input.bool(true, "Aktuelles Setup hervorheben", group = G_SHOW, tooltip = "Besteht auf der jüngsten Kerze ein offenes Setup, wird der Hintergrund ab der ersten Signalkerze (max. 10 Kerzen) eingefärbt und rechts ein Label mit Entry und SL angezeigt. Aus = Darstellung wie alle anderen Setups.")
hlLongCol   = input.color(#2979FF66, "Farbe aktuelles Setup Long", group = G_SHOW, inline = "hlcol")
hlShortCol  = input.color(#AA00FF66, "Short", group = G_SHOW, inline = "hlcol")
showTable   = input.bool(false, "Status-Tabelle anzeigen", group = G_SHOW)
sigSize     = sigSizeIn == "Klein" ? size.small : sigSizeIn == "Normal" ? size.normal : size.large
// Marker-Farben = Hintergrundfarben, deckend (Verwandtschaft sichtbar)
sigLongCol  = color.new(bgLongCol, 0)
sigShortCol = color.new(bgShortCol, 0)

// ═══════════════════════════════════════════════════════════════════
// FUNKTIONEN
// ═══════════════════════════════════════════════════════════════════
// Latched Trend: 1 = Kauf (2x Close > oberes BB), -1 = Verkauf (2x Close < unteres BB).
// Wechselt nur, wenn der Trigger in die Gegenrichtung kommt.
bbTrendState(simple int len, simple float mult) =>
    [mid, up, lo] = ta.bb(close, len, mult)
    var int state = 0
    if close > up and close[1] > up[1]
        state := 1
    else if close < lo and close[1] < lo[1]
        state := -1
    state

// Puffer in Preiseinheiten: mindestens X Ticks, optional mindestens Y Promille vom Kurs.
priceBuffer(float price, int ticks) =>
    math.max(ticks * syminfo.mintick, price * bufPermille / 1000.0)

// Hook fürs Refinement: Wann verfällt ein offenes Setup (Stop-Order noch nicht erreicht)?
setupExpired(int startBar) =>
    expiryBars > 0 and bar_index - startBar >= expiryBars

trendTxt(int s) => s == 1 ? "UP ▲" : s == -1 ? "DOWN ▼" : "–"
trendCol(int s) => s == 1 ? color.green : s == -1 ? color.red : color.gray

// ═══════════════════════════════════════════════════════════════════
// TIMEFRAMES: nur Weekly + Daily
// Daily-Chart:  Trigger = Weekly UND Daily, Setups werden gesucht.
// Weekly-Chart: Trigger = Weekly, keine Setups (Entscheidungen fallen im Daily).
// ═══════════════════════════════════════════════════════════════════
isDaily  = timeframe.isdaily and timeframe.multiplier == 1
isWeekly = timeframe.isweekly and timeframe.multiplier == 1
tfValid  = isDaily or isWeekly
inRange  = time >= startDate and time <= endDate

// ═══════════════════════════════════════════════════════════════════
// INDIKATOREN & TREND
// ═══════════════════════════════════════════════════════════════════
[basis, upper, lower] = ta.bb(close, bbLen, bbMult)
wr = ta.wpr(wrLen)

// Der Trigger steht erst mit dem Close der Trigger-Kerze fest. Das Regime gilt deshalb ab der
// Kerze DANACH (Grenze zwischen Trigger-Kerze und Folgekerze) – auch auf der laufenden Kerze.
chartState = bbTrendState(bbLen, bbMult)[1]
wrClosed   = barstate.isconfirmed ? wr : wr[1]
// Weekly im Daily-Chart ohne Repainting: nur abgeschlossene Wochen zählen.
wReqState  = request.security(syminfo.tickerid, "W", bbTrendState(bbLen, bbMult)[1], lookahead = barmerge.lookahead_on)

weeklyState = isWeekly ? chartState : isDaily ? wReqState : 0
dailyState  = isDaily ? chartState : 0

// Trigger laut Guide: Weekly UND Daily stehen auf Kauf bzw. Verkauf (im Weekly-Chart nur Weekly).
longTrend  = isDaily ? weeklyState == 1  and dailyState == 1  : weeklyState == 1
shortTrend = isDaily ? weeklyState == -1 and dailyState == -1 : weeklyState == -1

// ═══════════════════════════════════════════════════════════════════
// EARNINGS
// ═══════════════════════════════════════════════════════════════════
DAY_MS     = 86400000
earnWinMs  = earnDays * DAY_MS
nextEarn   = earnings.future_time
daysToEarn = na(nextEarn) ? na : (nextEarn - time) / DAY_MS
// Kerze liegt im Sperrfenster [Earnings − x Tage, Earnings], wenn sie es zeitlich berührt (Daily wie Weekly).
earnSoon   = not na(nextEarn) and time_close > nextEarn - earnWinMs and time <= nextEarn
earnBlock  = hideNearEarn and earnSoon
// Vergangene Earnings: Kerze, auf der TradingView die neuen Zahlen liefert.
pastEarn   = request.earnings(syminfo.tickerid, earnings.actual, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
earnBar    = not na(pastEarn)

// Farbe für das Sperrfenster vergangener Earnings, rückwirkend k Kerzen vor der Earnings-Kerze.
EARN_COL = color.new(color.gray, 55)
pastEarnCol(int k) =>
    showEarnBg and earnBar and time_close[k] > time - earnWinMs ? EARN_COL : na

// ═══════════════════════════════════════════════════════════════════
// SETUP-LOGIK
// Zeigt nur, ob ein Setup besteht und wo Entry (Stop-Order) und SL lägen.
// Wird der Entry erreicht, endet das Setup – kein Trade-Management.
// ═══════════════════════════════════════════════════════════════════
var int   setupDir   = 0     // 0 = kein Setup, 1 = Long, -1 = Short
var int   setupStart = na
var float entryLvl   = na
var float slLvl      = na

bool evNewSetup  = false
bool evMoveSetup = false
int  evTrigDir   = 0         // Richtung des Setups, dessen Entry auf diesem Bar erreicht wurde

// 1) Offenes Setup: Zuerst Abbruch prüfen – Trigger weg, Earnings, Verfall stehen schon zur
//    Eröffnung fest (dann würde man die Order vor Handelsbeginn löschen). Danach: Entry erreicht?
//    Gaps ohne Auslösung zählen nicht.
if setupDir != 0
    trendLost = setupDir == 1 ? not longTrend : not shortTrend
    if trendLost or earnBlock or setupExpired(setupStart)
        setupDir := 0
    else if setupDir == 1 ? high >= entryLvl : low <= entryLvl
        evTrigDir := setupDir
        setupDir  := 0

// 2) Neues Setup: Trigger aktiv, rote (Long) / grüne (Short) Kerze, %R-Close im Extrembereich.
//    Nachziehen laut Guide: Solange das Setup offen ist, zieht jeder weitere Downday (Long)
//    bzw. Upday (Short) den Entry auf die neue Kerze nach.
//    SL: liegt immer unter dem tiefsten Tief (Long) bzw. über dem höchsten Hoch (Short) seit der
//    ersten Signalkerze – auch Kerzen ohne Signal ziehen ihn nach. Er wandert nie zurück in die Bewegung.
longSig  = isDaily and inRange and enableLong  and longTrend  and close < open and wr <= wrLongLvl  and not earnBlock
shortSig = isDaily and inRange and enableShort and shortTrend and close > open and wr >= wrShortLvl and not earnBlock
moveSig  = setupDir == 1 ? close < open : setupDir == -1 ? close > open : false

if barstate.isconfirmed and evTrigDir == 0
    newDir = setupDir != 0 ? (moveSig ? setupDir : 0) : longSig ? 1 : shortSig ? -1 : 0
    if newDir != 0
        barSl = math.round_to_mintick(newDir == 1 ? low - priceBuffer(low, slTicks) : high + priceBuffer(high, slTicks))
        if setupDir == 0
            evNewSetup := true
            setupStart := bar_index
            slLvl      := barSl
        else
            evMoveSetup := true
            slLvl      := newDir == 1 ? math.min(slLvl, barSl) : math.max(slLvl, barSl)
        setupDir := newDir
        entryLvl := math.round_to_mintick(newDir == 1 ? high + priceBuffer(high, entryTicks) : low - priceBuffer(low, entryTicks))
    else if setupDir != 0
        // Kerze ohne Signal (Long: grün, Short: rot): Entry bleibt, SL folgt einem neuen Extrem der Bewegung.
        barSl = math.round_to_mintick(setupDir == 1 ? low - priceBuffer(low, slTicks) : high + priceBuffer(high, slTicks))
        slLvl := setupDir == 1 ? math.min(slLvl, barSl) : math.max(slLvl, barSl)

// ═══════════════════════════════════════════════════════════════════
// DARSTELLUNG – Bollinger-Bänder & Trend
// ═══════════════════════════════════════════════════════════════════
plot(showBB ? basis : na, "BB Mid",   color.new(color.gray, 20), 1)
plot(showBB ? upper : na, "BB Upper", color.new(color.blue, 40), 1)
plot(showBB ? lower : na, "BB Lower", color.new(color.red, 40), 1)

bgLong  = bgMode == "Trigger (W + D)" ? longTrend  : bgMode == "Weekly-Trend" and weeklyState == 1
bgShort = bgMode == "Trigger (W + D)" ? shortTrend : bgMode == "Weekly-Trend" and weeklyState == -1
bgcolor(bgLong  ? bgLongCol  : na, title = "Long-Trigger Zone")
bgcolor(bgShort ? bgShortCol : na, title = "Short-Trigger Zone")

// Earnings-Sperrfenster grau (über dem Trigger-Hintergrund).
// Aktueller Termin: direkt. Vergangene Termine: rückwirkend per Offset (max. 16 Kerzen ≈ 21 Kalendertage).
bgcolor(showEarnBg and earnSoon ? EARN_COL : na, title = "Earnings-Sperrfenster")
bgcolor(pastEarnCol(0),  offset = 0,   editable = false)
bgcolor(pastEarnCol(1),  offset = -1,  editable = false)
bgcolor(pastEarnCol(2),  offset = -2,  editable = false)
bgcolor(pastEarnCol(3),  offset = -3,  editable = false)
bgcolor(pastEarnCol(4),  offset = -4,  editable = false)
bgcolor(pastEarnCol(5),  offset = -5,  editable = false)
bgcolor(pastEarnCol(6),  offset = -6,  editable = false)
bgcolor(pastEarnCol(7),  offset = -7,  editable = false)
bgcolor(pastEarnCol(8),  offset = -8,  editable = false)
bgcolor(pastEarnCol(9),  offset = -9,  editable = false)
bgcolor(pastEarnCol(10), offset = -10, editable = false)
bgcolor(pastEarnCol(11), offset = -11, editable = false)
bgcolor(pastEarnCol(12), offset = -12, editable = false)
bgcolor(pastEarnCol(13), offset = -13, editable = false)
bgcolor(pastEarnCol(14), offset = -14, editable = false)
bgcolor(pastEarnCol(15), offset = -15, editable = false)

// Weekly-Trendwechsel (nur für Alerts; im Chart zeigt der Hintergrund die Grenze)
weeklyUpEdge   = weeklyState == 1  and weeklyState[1] != 1
weeklyDownEdge = weeklyState == -1 and weeklyState[1] != -1

// ═══════════════════════════════════════════════════════════════════
// DARSTELLUNG – Setup (nur Linien, inkl. des Bars, auf dem der Entry erreicht wird)
// ═══════════════════════════════════════════════════════════════════
showLvls = setupDir != 0 or evTrigDir != 0
plot(showLvls ? entryLvl : na, "Entry (Stop-Order)", color.blue, 2, plot.style_linebr)
plot(showLvls ? slLvl : na, "Stop-Loss", color.red, 1, plot.style_linebr)

// Marker auf der Signalkerze (neues Setup oder nachgezogen): gefülltes Label mit Spitze zur Kerze,
// weißer fetter Text L = Long (unter der Kerze) / S = Short (darüber). Feste Größe unabhängig vom Zoom.
// Die Marker des jüngsten Setups werden gemerkt, um sie beim aktuellen Setup umzufärben.
var array<label> lastMarks = array.new<label>()
var int          marksDir  = 0
sigBar = evNewSetup or evMoveSetup
if evNewSetup
    array.clear(lastMarks)
    marksDir := setupDir
if sigBar and setupDir == 1
    array.push(lastMarks, label.new(bar_index, low, "L", yloc = yloc.belowbar, style = label.style_label_up, color = sigLongCol, textcolor = color.white, size = sigSize, text_formatting = text.format_bold))
if sigBar and setupDir == -1
    array.push(lastMarks, label.new(bar_index, high, "S", yloc = yloc.abovebar, style = label.style_label_down, color = sigShortCol, textcolor = color.white, size = sigSize, text_formatting = text.format_bold))

// ═══════════════════════════════════════════════════════════════════
// DARSTELLUNG – Aktuelles Setup hervorheben (nur auf der jüngsten Kerze bekannt)
// Hintergrund rückwirkend per Offset ab der ersten Signalkerze (max. 10 Kerzen) + Label rechts.
// ═══════════════════════════════════════════════════════════════════
curActive = hlCurrent and barstate.islast and setupDir != 0
curCol    = setupDir == 1 ? hlLongCol : hlShortCol
curSetupCol(int k) =>
    curActive and bar_index - k >= setupStart ? curCol : na

bgcolor(curSetupCol(0), offset = 0,  title = "Aktuelles Setup")
bgcolor(curSetupCol(1), offset = -1, editable = false)
bgcolor(curSetupCol(2), offset = -2, editable = false)
bgcolor(curSetupCol(3), offset = -3, editable = false)
bgcolor(curSetupCol(4), offset = -4, editable = false)
bgcolor(curSetupCol(5), offset = -5, editable = false)
bgcolor(curSetupCol(6), offset = -6, editable = false)
bgcolor(curSetupCol(7), offset = -7, editable = false)
bgcolor(curSetupCol(8), offset = -8, editable = false)
bgcolor(curSetupCol(9), offset = -9, editable = false)

var label curLbl = na
if barstate.islast
    // Marker des jüngsten Setups: Farbe der Hervorhebung, solange es aktuell ist, sonst normal.
    markCol = curActive ? color.new(curCol, 0) : marksDir == 1 ? sigLongCol : sigShortCol
    for m in lastMarks
        label.set_color(m, markCol)
    label.delete(curLbl)
    curLbl := na
    if curActive
        curTxt = (setupDir == 1 ? "LONG-SETUP" : "SHORT-SETUP") + "\nEntry " + str.tostring(entryLvl, format.mintick) + "\nSL " + str.tostring(slLvl, format.mintick)
        curLbl := label.new(bar_index, entryLvl, curTxt, style = label.style_label_left, color = color.new(curCol, 0), textcolor = color.white, size = size.normal, text_formatting = text.format_bold)

// Nur im Datenfenster sichtbar (zur Kontrolle, was der Indikator je Bar sieht)
plot(weeklyState, "Trend Weekly (1 / -1)", display = display.data_window)
plot(dailyState, "Trend Daily (1 / -1)", display = display.data_window)
plot(wrClosed, "Williams %R (abgeschl. Kerze)", display = display.data_window)

// ═══════════════════════════════════════════════════════════════════
// STATUS-TABELLE
// ═══════════════════════════════════════════════════════════════════
var table tbl = table.new(position.top_right, 2, 7, bgcolor = color.new(color.gray, 85), border_width = 1)
if showTable and barstate.islast
    statusTxt = setupDir == 1 ? "Long-Setup" : setupDir == -1 ? "Short-Setup" : "Kein Setup"
    lvlTxt    = setupDir != 0 ? str.tostring(entryLvl, format.mintick) + " / SL " + str.tostring(slLvl, format.mintick) : "–"
    earnTxt   = na(nextEarn) ? "keine Daten" : str.format_time(int(nextEarn), "dd.MM.yyyy", syminfo.timezone) + " (" + str.tostring(math.ceil(daysToEarn)) + " T)"
    table.cell(tbl, 0, 0, "Trend W", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 0, trendTxt(weeklyState), text_color = trendCol(weeklyState), text_size = size.small)
    table.cell(tbl, 0, 1, "Trend D", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 1, isDaily ? trendTxt(dailyState) : "–", text_color = trendCol(dailyState), text_size = size.small)
    table.cell(tbl, 0, 2, "Williams %R", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 2, str.tostring(wrClosed, "0.0"), text_color = wrClosed <= wrLongLvl ? color.green : wrClosed >= wrShortLvl ? color.red : chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 3, "Status", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 3, statusTxt, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 4, "Entry / SL", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 4, lvlTxt, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 5, "Earnings", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 5, earnTxt, text_color = earnSoon ? color.orange : chart.fg_color, text_size = size.small)
    if not tfValid
        table.cell(tbl, 0, 6, "⚠", text_color = color.orange, text_size = size.small)
        table.cell(tbl, 1, 6, "Nur für Daily- und Weekly-Chart", text_color = color.orange, text_size = size.small)

// ═══════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════
alertcondition(weeklyUpEdge, "Weekly UP", "{{ticker}}: Weekly-Trend UP")
alertcondition(weeklyDownEdge, "Weekly DOWN", "{{ticker}}: Weekly-Trend DOWN")
alertcondition((evNewSetup or evMoveSetup) and setupDir == 1, "Long-Setup", "{{ticker}}: Long-Setup – Stop-Buy setzen/nachziehen")
alertcondition((evNewSetup or evMoveSetup) and setupDir == -1, "Short-Setup", "{{ticker}}: Short-Setup – Stop-Sell setzen/nachziehen")
alertcondition(evTrigDir == 1, "Long-Entry erreicht", "{{ticker}}: Long-Entry erreicht")
alertcondition(evTrigDir == -1, "Short-Entry erreicht", "{{ticker}}: Short-Entry erreicht")
