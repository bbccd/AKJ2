//@version=6
indicator("AKJ2.0 – Trend & Setup Detector", shorttitle = "AKJ2.0", overlay = true, max_labels_count = 500, max_boxes_count = 500)

// Zweck: Aktien schnell auf mögliche Setups scannen. Bewusst kein Trade-Management und
// keine Entry-/Exit-Marker – das kommt später in die strategy()-Version.

// ═══════════════════════════════════════════════════════════════════
// EINSTELLUNGEN
// ═══════════════════════════════════════════════════════════════════
G_RANGE = "Zeitraum"
startDate = input.time(timestamp("2020-01-01"), "Startdatum", group = G_RANGE)
endDate   = input.time(timestamp("2099-12-31"), "Enddatum", group = G_RANGE)

G_TREND = "Trend"
playMode  = input.string("W + D", "Spielweise", options = ["W + D", "M + W", "D + 4h"], group = G_TREND, tooltip = "W + D: Weekly übergeordnet, Trade im Daily-Chart (Weekly-Chart zeigt nur den Weekly-Trigger). M + W: Monthly übergeordnet, Trade im Weekly-Chart. D + 4h: Daily übergeordnet, Trade im 4h-Chart (Daily- und Weekly-Chart zeigen nur ihren Trigger; 4h-Chart mit regulären Handelszeiten verwenden). Das Monthly-Chart zeigt immer den Monthly-Trigger. Für mehrere Spielweisen im selben Chart den Indikator mehrfach hinzufügen.")
bbLen     = input.int(10, "BB Länge", minval = 1, group = G_TREND)
bbMult    = input.float(1.0, "BB Standardabweichung", minval = 0.1, step = 0.1, group = G_TREND)
showBB    = input.bool(true, "Bollinger-Bänder anzeigen, Dicke", group = G_TREND, inline = "bb")
bbWidth   = input.int(3, "", minval = 1, maxval = 4, group = G_TREND, inline = "bb")
bbFillOn  = input.bool(true, "Bereich zwischen den Bändern füllen", group = G_TREND, inline = "bbfill", tooltip = "Dezente Füllung, damit sich die Bollinger-Bänder von den Moving Averages abheben. Neutrales Grau mit geringer Deckkraft – funktioniert im hellen und dunklen Chart.")
bbFillCol = input.color(#787B8614, "", group = G_TREND, inline = "bbfill")
bgLongCol  = input.color(#1FBFB840, "Hintergrund Long / Short", group = G_TREND, inline = "bgcol")
bgShortCol = input.color(#F0629240, "", group = G_TREND, inline = "bgcol")
bgMode    = input.string("Trigger", "Hintergrund", options = ["Trigger", "Weekly-Trend", "Aus"], group = G_TREND, tooltip = "Trigger: im Trade-Chart (W + D: Daily, M + W: Weekly, D + 4h: 4h) nur gefärbt, wenn übergeordneter TF und Trade-TF beide Kauf (Long-Farbe) bzw. beide Verkauf (Short-Farbe) sind, sonst kein Hintergrund. Im Chart des übergeordneten TF (und im Monthly-Chart) zeigt er dessen Trigger. Weekly-Trend: nur der übergeordnete Trend (W, M bzw. D je nach Spielweise), wie im alten AKJ2.")
regNextShow    = input.bool(true, "Regimewechsel auf nächster Kerze ankündigen", group = G_TREND, tooltip = "Steht nach dem Close der jüngsten Kerze fest, dass sich das Regime ändert, wird die Stelle der noch nicht vorhandenen nächsten Kerze in der Farbe des neuen Regimes hinterlegt. Weder Long noch Short: Farbe „Kein Regime“.")
regNextSame    = input.bool(true, "Auch gleichbleibendes Regime zeigen", group = G_TREND, tooltip = "Bleibt das Regime nach dem Close gleich, wird die Stelle der nächsten Kerze in der normalen Hintergrundfarbe hinterlegt. Ohne Regime bleibt sie leer. Gilt im Daily, Weekly und Monthly.")
regNextLongCol = input.color(#1FBFB8A0, "Wechsel Long / Short / Kein Regime", group = G_TREND, inline = "regcol")
regNextShortCol = input.color(#F06292A0, "", group = G_TREND, inline = "regcol")
regNextNoneCol = input.color(#FFB300A0, "", group = G_TREND, inline = "regcol")

G_SETUP = "Setup & Entry"
enableLong  = input.bool(true, "Long-Setups", group = G_SETUP)
enableShort = input.bool(true, "Short-Setups", group = G_SETUP)
wrLen       = input.int(4, "Williams %R Länge", minval = 1, group = G_SETUP)
wrLongLvl   = input.float(-80.0, "%R Long: Close ≤", group = G_SETUP)
wrShortLvl  = input.float(-20.0, "%R Short: Close ≥", group = G_SETUP)
// Puffer (Issue #24, Handelsplan): bis zur Kurs-Schwelle fest X Ticks, darüber Y ‰ vom Kurs, auf den Tick aufgerundet.
bufTicks    = input.int(3, "Puffer: Ticks / Schwelle (Kurs) / ‰ darüber", minval = 0, group = G_SETUP, inline = "buf", tooltip = "Entry und Stop-Loss liegen je einen Puffer jenseits von Hoch bzw. Tief der Signalkerze. Bis zur Schwelle (Kurs): fester Puffer in Ticks. Darüber: Promille vom Kurs, auf den nächsten Tick aufgerundet (0,3 ‰: 500 $ → 0,15 $).")
bufThresh   = input.float(100.0, "", minval = 0.0, step = 10.0, group = G_SETUP, inline = "buf")
bufPermille = input.float(0.3, "", minval = 0.0, step = 0.1, group = G_SETUP, inline = "buf")
roundAvoid  = input.bool(true, "Glatte Zahlen meiden (Raster)", group = G_SETUP, inline = "round", tooltip = "Entry und Stop-Loss liegen mindestens einen Puffer jenseits glatter Kurse (Raster 0,50 = ganze und halbe Dollar, damit auch 5er und 10er). Läge das Level innerhalb eines Puffers vor einer Rasterstufe, wird es einen Puffer hinter die Stufe gelegt – der Abstand wird dann etwas größer.")
roundStep   = input.float(0.5, "", minval = 0.01, step = 0.5, group = G_SETUP, inline = "round")
expiryBars  = input.int(0, "Setup verfällt nach X Bars (0 = nie)", minval = 0, group = G_SETUP, tooltip = "Platzhalter fürs Refinement. Gezählt ab dem ersten Setup-Bar.")
riskFilter  = input.bool(true, "Risiko-Filter", group = G_SETUP, tooltip = "Risiko = |Entry − SL| / Entry. Setups außerhalb des Bereichs werden nicht angezeigt (Linien, Marker, Hervorhebung, Alerts) und im Screener nicht gelistet. Zu klein: Gefahr, durch Volatilität ausgestoppt zu werden. Zu groß: Trade braucht zu lange.")
riskMinWD   = input.float(2.0, "Risiko W + D min. / max. (%)", minval = 0.0, step = 0.1, group = G_SETUP, inline = "riskWD")
riskMaxWD   = input.float(7.0, "", minval = 0.0, step = 0.1, group = G_SETUP, inline = "riskWD")
riskMinMW   = input.float(3.0, "Risiko M + W min. / max. (%)", minval = 0.0, step = 0.1, group = G_SETUP, inline = "riskMW")
riskMaxMW   = input.float(12.0, "", minval = 0.0, step = 0.1, group = G_SETUP, inline = "riskMW")
riskMinDH   = input.float(1.0, "Risiko D + 4h min. / max. (%)", minval = 0.0, step = 0.1, group = G_SETUP, inline = "riskDH")
riskMaxDH   = input.float(5.0, "", minval = 0.0, step = 0.1, group = G_SETUP, inline = "riskDH")

// Fair Value Gaps (Issue #18): Default AUS – ausgeschaltet verhält sich der Indikator exakt wie vorher.
G_FVG = "Fair Value Gaps"
fvgFilter = input.bool(false, "FVG-Filter: kein Setup bei FVG im Gewinnbereich", group = G_FVG, tooltip = "Setup gilt als ungültig, wenn ein ungefülltes gegenläufiges FVG (Long: bärisch, Short: bullisch) den Bereich zwischen Entry und Ziel bei CRV 1:1 auch nur teilweise überlappt. Wirkt wie der Risiko-Filter: Setup wird nicht angezeigt (Linien, Marker, Hervorhebung, Alerts, Screener), läuft intern weiter. FVG = Lücke über drei Kerzen; zählt, bis sie komplett gefüllt ist.")
fvgUse4h  = input.bool(true, "4h (Rückschau in Kerzen)", group = G_FVG, inline = "fvg4h", tooltip = "Nur in der Spielweise D + 4h (Trade im 4h-Chart).")
fvgLb4h   = input.int(1000, "", minval = 1, maxval = 5000, group = G_FVG, inline = "fvg4h")
fvgUseD   = input.bool(true, "Daily (Rückschau in Kerzen)", group = G_FVG, inline = "fvgD", tooltip = "Nur in den Spielweisen W + D und D + 4h. In M + W werden nur Weekly und Monthly beachtet.")
fvgLbD    = input.int(500, "", minval = 1, maxval = 5000, group = G_FVG, inline = "fvgD")
fvgUseW   = input.bool(true, "Weekly (Rückschau in Kerzen)", group = G_FVG, inline = "fvgW")
fvgLbW    = input.int(520, "", minval = 1, maxval = 5000, group = G_FVG, inline = "fvgW")
fvgUseM   = input.bool(true, "Monthly (Rückschau in Kerzen)", group = G_FVG, inline = "fvgM")
fvgLbM    = input.int(240, "", minval = 1, maxval = 5000, group = G_FVG, inline = "fvgM")
fvgShow   = input.bool(false, "Offene FVGs anzeigen (bullisch / bärisch)", group = G_FVG, inline = "fvgshow", tooltip = "Zur Kontrolle: zeichnet alle noch nicht gefüllten FVGs der gewählten Zeiteinheiten als Kasten (Beschriftung 4h / D / W / M), max. 400 (die nächsten am Kurs; sind es mehr, erscheint unten rechts ein Hinweis). Nur im Trade-Chart. Farben: bullisch, bärisch.")
fvgBullCol = input.color(#4CAF5026, "", group = G_FVG, inline = "fvgshow")
fvgBearCol = input.color(#FF525226, "", group = G_FVG, inline = "fvgshow")

G_EARN = "Earnings"
showEarnBg   = input.bool(true, "Sperrfenster grau hinterlegen", group = G_EARN, tooltip = "Grauer Hintergrund vom Beginn des Sperrfensters bis einschließlich Earnings-Tag bzw. -Woche. Vergangene Termine: TradingView liefert sie bei Veröffentlichung nach Börsenschluss erst am Folgetag – dann ist dieser Tag mit grau.")
earnLineShow = input.bool(true, "Earnings-Linie (Daily / 4h), Farbe, Dicke", group = G_EARN, inline = "earnline", tooltip = "Senkrechte Linie auf der letzten Kerze des Sperrfensters. Vergangene Termine: auf der Kerze, auf der TradingView die Zahlen liefert – bei Veröffentlichung nach Börsenschluss also der Folgetag.")
earnLineCol  = input.color(#55555599, "", group = G_EARN, inline = "earnline")
earnLineW    = input.int(3, "", minval = 1, maxval = 6, group = G_EARN, inline = "earnline")
hideNearEarn = input.bool(true, "Keine Signale im Sperrfenster", group = G_EARN)
earnDaysWD   = input.int(8, "Sperrfenster W + D (Kalendertage vor Earnings)", minval = 0, maxval = 21, group = G_EARN)
earnDaysMW   = input.int(8, "Sperrfenster M + W (Kalendertage vor Earnings)", minval = 0, maxval = 21, group = G_EARN)
earnDaysDH   = input.int(8, "Sperrfenster D + 4h (Kalendertage vor Earnings)", minval = 0, maxval = 21, group = G_EARN)

// Farbverlauf kurz → lang wie im TradingView-„Moving Average Ribbon“: Gelb → Orange → Rot.
G_MA = "Moving Averages"
maShow    = input.bool(true, "Moving Averages anzeigen", group = G_MA)
maType    = input.string("SMA", "Typ (für alle)", options = ["SMA", "EMA"], group = G_MA)
maWidth   = input.int(3, "Liniendicke", minval = 1, maxval = 4, group = G_MA)
maStyleIn = input.string("Gestrichelt", "Linienart", options = ["Durchgezogen", "Gestrichelt", "Gepunktet"], group = G_MA)
ma1On  = input.bool(true, "MA 1", group = G_MA, inline = "ma1")
ma1Len = input.int(20, "", minval = 1, group = G_MA, inline = "ma1")
ma1Col = input.color(#F6C309, "", group = G_MA, inline = "ma1")
ma2On  = input.bool(true, "MA 2", group = G_MA, inline = "ma2")
ma2Len = input.int(50, "", minval = 1, group = G_MA, inline = "ma2")
ma2Col = input.color(#FB9800, "", group = G_MA, inline = "ma2")
