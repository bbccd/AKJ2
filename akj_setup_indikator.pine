G_INFO = "Zusatzinfos"
athShow  = input.bool(true, "All-Time High anzeigen", group = G_INFO)
athCol   = input.color(#FFE135, "Farbe, Dicke", group = G_INFO, inline = "ath")
athWidth = input.int(3, "", minval = 1, maxval = 6, group = G_INFO, inline = "ath")
symInfoGap  = input.float(6.0, "Abstand der Tabelle von oben (% der Charthöhe)", minval = 0.0, maxval = 40.0, step = 0.5, group = G_INFO, tooltip = "Unsichtbare Leerzeile über der Tabelle, damit sie unter der Statuszeile steht. Bei vielen Indikatoren in der Statuszeile erhöhen.")
symInfoShow = input.bool(true, "Sektor / Industrie / Sektor-ETF (oben Mitte)", group = G_INFO, tooltip = "Sektor und Industrie kommen direkt von TradingView. Der Sektor-ETF (Select Sector SPDR) ist eine eigene Näherung aus dem TradingView-Sektor (≠ GICS) und gilt nur für S&P-500-Aktien – ob die Aktie im S&P 500 ist, liefert Pine nicht. Daher „(evtl. …)“, nur bei US-Aktien.")

G_SHOW = "Anzeige"
sigSizeIn   = input.string("Normal", "Größe Signal-Marker", options = ["Klein", "Normal", "Groß"], group = G_SHOW)
hlCurrent   = input.bool(true, "Aktuelles Setup hervorheben", group = G_SHOW, tooltip = "Besteht auf der jüngsten Kerze ein offenes Setup, wird der Hintergrund ab der ersten Signalkerze (max. 10 Kerzen) eingefärbt und rechts ein Label mit Entry und SL angezeigt. Aus = Darstellung wie alle anderen Setups.")
hlLongCol   = input.color(#2979FF66, "Aktuelles Setup Long / Short", group = G_SHOW, inline = "hlcol")
hlShortCol  = input.color(#AA00FF66, "", group = G_SHOW, inline = "hlcol")
showTable   = input.bool(false, "Status-Tabelle anzeigen", group = G_SHOW)
sigSize     = sigSizeIn == "Klein" ? size.small : sigSizeIn == "Normal" ? size.normal : size.large
// Marker-Farben = Hintergrundfarben, deckend (Verwandtschaft sichtbar)
sigLongCol  = color.new(bgLongCol, 0)
sigShortCol = color.new(bgShortCol, 0)

// ═══════════════════════════════════════════════════════════════════
// FUNKTIONEN
// ═══════════════════════════════════════════════════════════════════
// Latched Trend: 1 = Kauf (2x Close > oberes BB), -1 = Verkauf (2x Close < unteres BB).
// Wechselt nur, wenn der Trigger in die Gegenrichtung kommt.
bbTrendState(simple int len, simple float mult) =>
    [mid, up, lo] = ta.bb(close, len, mult)
    var int state = 0
    if close > up and close[1] > up[1]
        state := 1
    else if close < lo and close[1] < lo[1]
        state := -1
    state

// Puffer in Preiseinheiten (Issue #24): bis zur Schwelle fest X Ticks, darüber Y ‰ vom Kurs, auf den Tick aufgerundet.
priceBuffer(float price) =>
    raw = price > bufThresh ? price * bufPermille / 1000.0 : bufTicks * syminfo.mintick
    math.ceil(raw / syminfo.mintick - 1e-6) * syminfo.mintick

// Entry- bzw. SL-Level: Bezugskurs ± Puffer. dir = 1: Level über dem Kurs (Long-Entry, Short-SL),
// dir = -1: darunter (Long-SL, Short-Entry).
// Glatte Zahlen meiden (Issue #24): Liegt die nächste Rasterstufe (z. B. ganzer/halber Dollar) in Richtung dir
// näher als Level + ein weiterer Puffer, wird das Level einen Puffer jenseits dieser Stufe gelegt.
bufLevel(float price, int dir) =>
    buf = priceBuffer(price)
    lvl = price + dir * buf
    if roundAvoid and roundStep > 0
        r = (dir == 1 ? math.ceil(price / roundStep - 1e-6) : math.floor(price / roundStep + 1e-6)) * roundStep
        if dir * (lvl + dir * buf - r) > 0
            lvl := r + dir * buf
    math.round_to_mintick(lvl)

// Hook fürs Refinement: Wann verfällt ein offenes Setup (Stop-Order noch nicht erreicht)?
setupExpired(int startBar) =>
    expiryBars > 0 and bar_index - startBar >= expiryBars

// Moving Average je nach Typ (beide berechnen, damit die ta-Funktionen auf jeder Kerze laufen).
maCalc(simple int len) =>
    e = ta.ema(close, len)
    s = ta.sma(close, len)
    maType == "EMA" ? e : s

// TradingView-Sektor (FactSet-Einteilung) → SPDR-Sektor-ETF (GICS). Näherung; bekannte Abweichungen über
// die Industrie korrigiert (REITs → XLRE, Internet-Dienste wie Alphabet/Meta → XLC, Discounter → XLP).
sectorEtf(string sec, string ind) =>
    string etf = "–"
    if str.contains(ind, "Real Estate")
        etf := "XLRE"
    else if ind == "Internet Software/Services"
        etf := "XLC"
    else if ind == "Food Retail" or ind == "Discount Stores"
        etf := "XLP"
    else
        etf := switch sec
            "Technology Services"    => "XLK"
            "Electronic Technology"  => "XLK"
            "Communications"         => "XLC"
            "Consumer Services"      => "XLY"
            "Consumer Durables"      => "XLY"
            "Retail Trade"           => "XLY"
            "Consumer Non-Durables"  => "XLP"
            "Health Technology"      => "XLV"
            "Health Services"        => "XLV"
            "Finance"                => "XLF"
            "Energy Minerals"        => "XLE"
            "Utilities"              => "XLU"
            "Non-Energy Minerals"    => "XLB"
            "Process Industries"     => "XLB"
            "Producer Manufacturing" => "XLI"
            "Industrial Services"    => "XLI"
            "Commercial Services"    => "XLI"
            "Distribution Services"  => "XLI"
            "Transportation"         => "XLI"
            => "–"
    etf

// Fair Value Gap: Lücke über drei Kerzen. Bullisch: Tief[0] > Hoch[2], bärisch: Hoch[0] < Tief[2].
// top/bot = noch ungefüllter Rest der Lücke (wird beim Anlaufen verkleinert).
type Fvg
    float top
    float bot
    int   dir            // 1 = bullisch, -1 = bärisch
    int   tfId           // 0 = 4h, 1 = Daily, 2 = Weekly, 3 = Monthly
    int   idx            // Nummer der jüngsten der drei Kerzen in ihrem TF (für die Rückschau)
    int   t              // Startzeit der ältesten der drei Kerzen (nur für die Anzeige)
    bool  dead = false   // gefüllt oder Rückschau abgelaufen (wird aus den Listen nach und nach entfernt)

// Performance (Issue #21): FVGs liegen in zwei SORTIERTEN Listen – bullisch absteigend nach top (nächstes unter
// dem Kurs zuerst), bärisch aufsteigend nach bot (nächstes über dem Kurs zuerst). Füllen und Treffer-Prüfung
// brechen ab, sobald ein FVG außer Reichweite liegt, statt jede Kerze alle FVGs zu durchlaufen.
fvgInsert(array<Fvg> list, Fvg f) =>
    n = list.size()
    int i = 0
    while i < n and (f.dir == 1 ? list.get(i).top > f.top : list.get(i).bot < f.bot)
        i += 1
    list.insert(i, f)

// Neues FVG anlegen (falls Lücke): in die sortierte Liste und in die Ablauf-Warteschlange seines TF. Rückgabe 1/0.
fvgAdd(array<Fvg> bull, array<Fvg> bear, array<Fvg> queue, int tfId, float h0, float l0, float h2, float l2, int t2, int idx) =>
    Fvg f = na
    if l0 > h2
        f := Fvg.new(l0, h2, 1, tfId, idx, t2)
    else if h0 < l2
        f := Fvg.new(l2, h0, -1, tfId, idx, t2)
    if not na(f)
        fvgInsert(f.dir == 1 ? bull : bear, f)
        queue.push(f)
    na(f) ? 0 : 1

// Rückschau: Warteschlange je TF in Entstehungsreihenfolge – vorne liegt immer das älteste FVG, also reicht es,
// vorne abzuarbeiten, bis eines noch nicht abgelaufen ist. Rückgabe: Anzahl neu abgelaufener FVGs.
fvgExpire(array<Fvg> queue, int cnt, int lb) =>
    int killed = 0
    while queue.size() > 0
        f = queue.first()
        if f.dead
            queue.shift()
        else if cnt - f.idx > lb
            f.dead := true
            queue.shift()
            killed += 1
        else
            break
    killed

// Füllen mit der aktuellen Kerze: nur die vorderen FVGs der Liste können betroffen sein. Rückgabe: Anzahl gefüllter.
fvgFill(array<Fvg> list, bool bull, float lo, float hi) =>
    int filled = 0
    int i = 0
    while i < list.size()
        f = list.get(i)
        if f.dead
            list.remove(i)
        else if bull ? lo < f.top : hi > f.bot
            if bull ? lo <= f.bot : hi >= f.top
                f.dead := true
                list.remove(i)
                filled += 1
            else
                f.top := bull ? lo : f.top
                f.bot := bull ? f.bot : hi
                i += 1
        else
            break
    filled

// Erledigte FVGs aus einer Liste entfernen (nur gelegentlich nötig, damit die Listen nicht wachsen).
fvgCompact(array<Fvg> list) =>
    n = list.size()
    if n > 0
        for i = n - 1 to 0
            if list.get(i).dead
                list.remove(i)

// Kasten für ein offenes FVG zeichnen (erledigte werden übersprungen).
fvgBox(array<box> boxes, Fvg f) =>
    if not f.dead
        tfTxt = f.tfId == 0 ? "4h" : f.tfId == 1 ? "D" : f.tfId == 2 ? "W" : "M"
        col   = f.dir == 1 ? fvgBullCol : fvgBearCol
        boxes.push(box.new(f.t, f.top, time, f.bot, xloc = xloc.bar_time, extend = extend.right, border_color = col, bgcolor = col, text = tfTxt, text_size = size.small, text_halign = text.align_left, text_color = color.new(col, 0)))

trendTxt(int s) => s == 1 ? "UP ▲" : s == -1 ? "DOWN ▼" : "–"
trendCol(int s) => s == 1 ? color.green : s == -1 ? color.red : color.gray

// ═══════════════════════════════════════════════════════════════════
// TIMEFRAMES / SPIELWEISE
// W + D (Default): Trade-Chart Daily (Trigger W UND D, Setups); Weekly-Chart nur Weekly-Trigger.
// M + W:           Trade-Chart Weekly (Trigger M UND W, Setups); Daily-Chart nichts.
// D + 4h:          Trade-Chart 4h (Trigger D UND 4h, Setups); Daily- und Weekly-Chart nur ihr Trigger.
// Monthly-Chart: in allen Spielweisen nur der Monthly-Trigger, keine Setups.
// ═══════════════════════════════════════════════════════════════════
isMW       = playMode == "M + W"
isDH       = playMode == "D + 4h"
is4h       = timeframe.period == "240"
isDaily    = timeframe.isdaily and timeframe.multiplier == 1
isWeekly   = timeframe.isweekly and timeframe.multiplier == 1
isMonthly  = timeframe.ismonthly and timeframe.multiplier == 1
htfTf      = isMW ? "M" : isDH ? "D" : "W"          // übergeordneter Timeframe
ltfName    = isMW ? "W" : isDH ? "4h" : "D"         // Trade-Timeframe (nur für Beschriftungen)
tradeChart = isMW ? isWeekly : isDH ? is4h : isDaily   // Chart, in dem Setups gesucht werden
trigChart  = (not isMW and isWeekly) or isMonthly or (isDH and isDaily)   // Chart, der nur einen Trigger zeigt
tfValid    = tradeChart or trigChart
riskMin    = isMW ? riskMinMW : isDH ? riskMinDH : riskMinWD
riskMax    = isMW ? riskMaxMW : isDH ? riskMaxDH : riskMaxWD
earnDays   = isMW ? earnDaysMW : isDH ? earnDaysDH : earnDaysWD
inRange    = time >= startDate and time <= endDate

// ═══════════════════════════════════════════════════════════════════
// INDIKATOREN & TREND
// ═══════════════════════════════════════════════════════════════════
[basis, upper, lower] = ta.bb(close, bbLen, bbMult)
wr = ta.wpr(wrLen)

// Der Trigger steht erst mit dem Close der Trigger-Kerze fest. Das Regime gilt deshalb ab der
// Kerze DANACH (Grenze zwischen Trigger-Kerze und Folgekerze) – auch auf der laufenden Kerze.
chartStateNext = bbTrendState(bbLen, bbMult)
chartState     = chartStateNext[1]
wrClosed   = barstate.isconfirmed ? wr : wr[1]
// Höhere TFs – Performance (Issue #21): EIN Abruf je Zeiteinheit (D, W, M) liefert alles, was gebraucht wird
// (Trend, FVG-Kerzen, ATH), statt mehrerer Einzelabrufe. Ist die Zeiteinheit nicht höher als das Chart, wird
// das Chart selbst abgefragt ("") – sonst müsste TradingView z. B. im Weekly-Chart alle Daily-Kerzen laden.
// Werte mit [1] + lookahead = zuletzt ABGESCHLOSSENE Kerze (kein Repainting); s0 = Zustand inkl. laufender Kerze.
htfData() =>
    s = bbTrendState(bbLen, bbMult)
    [s[1], s, high[1], low[1], high[3], low[3], time[3], time[1], ta.max(high)[1]]
chartSec = timeframe.in_seconds()
tfD = chartSec < timeframe.in_seconds("D") ? "D" : ""
tfW = chartSec < timeframe.in_seconds("W") ? "W" : ""
tfM = chartSec < timeframe.in_seconds("M") ? "M" : ""
[dS1, dS0, dH, dL, dH2, dL2, dT2, dT, dAth] = request.security(syminfo.tickerid, tfD, htfData(), lookahead = barmerge.lookahead_on)
[wS1, wS0, wH, wL, wH2, wL2, wT2, wT, wAth] = request.security(syminfo.tickerid, tfW, htfData(), lookahead = barmerge.lookahead_on)
[mS1, mS0, mH, mL, mH2, mL2, mT2, mT, mAth] = request.security(syminfo.tickerid, tfM, htfData(), lookahead = barmerge.lookahead_on)

// Übergeordneter TF (W, M bzw. D) im Trade-Chart ohne Repainting: nur abgeschlossene Kerzen zählen.
htfReqState = isMW ? mS1 : isDH ? dS1 : wS1
// Zustand nach dem Close dieser Kerze, falls die Woche bzw. der Monat bzw. der Tag damit endet (W + D: Freitag,
// M + W: nächste Weekly-Kerze beginnt im neuen Monat, D + 4h: letzte 4h-Kerze der regulären Sitzung).
// Endet die Woche an einem Feiertag vorher, greift das nicht.
DAY_MS      = 86400000
htfReqNow   = isMW ? mS0 : isDH ? dS0 : wS0
htfEnds     = isMW ? month(time + 7 * DAY_MS) != month(time) : isDH ? session.islastbar_regular : dayofweek == dayofweek.friday
htfNext     = htfEnds ? htfReqNow : htfReqState

// htfState: übergeordneter Trend (im Trigger-Chart dessen eigener Trend), ltfState: Trend des Trade-TF.
htfState = tradeChart ? htfReqState : trigChart ? chartState : 0
ltfState = tradeChart ? chartState : 0

// Trigger laut Guide: übergeordneter TF UND Trade-TF stehen auf Kauf bzw. Verkauf (im Trigger-Chart nur dessen Trend).
longTrend  = tradeChart ? htfState == 1  and ltfState == 1  : htfState == 1
shortTrend = tradeChart ? htfState == -1 and ltfState == -1 : htfState == -1
// Trigger nach dem Close dieser Kerze: Beendet der Close das Regime, entsteht kein Setup mehr.
longNext   = tradeChart and htfNext == 1  and chartStateNext == 1
shortNext  = tradeChart and htfNext == -1 and chartStateNext == -1

// ═══════════════════════════════════════════════════════════════════
// EARNINGS
// ═══════════════════════════════════════════════════════════════════
earnWinMs  = earnDays * DAY_MS
nextEarn   = earnings.future_time
daysToEarn = na(nextEarn) ? na : (nextEarn - time) / DAY_MS
// Vergleich nach Kalendertagen, nicht nach Uhrzeit: Bei Zahlen vor Börsenbeginn liegt der Termin vor dem
// Kerzenbeginn (9:30) – der Earnings-Tag fiel sonst aus dem Fenster (Issue #1).
// Kalendertag (Mitternacht UTC) eines Zeitpunkts in der Börsen-Zeitzone.
dayOf(int t) =>
    timestamp("UTC", year(t, syminfo.timezone), month(t, syminfo.timezone), dayofmonth(t, syminfo.timezone), 0, 0)
// Earnings-Tag als UTC-Datum: stimmt für Termine mit Uhrzeit (vor Börsenbeginn bis abends) wie für reine
// Datumsangaben (Mitternacht UTC – in New Yorker Zeit wäre das schon der Vortag).
earnDay    = na(nextEarn) ? int(na) : int(nextEarn) - int(nextEarn) % DAY_MS
// Liegt der Zeitraum [firstDay, lastDay] (Kalendertage) im Sperrfenster [Earnings-Tag − x Tage, Earnings-Tag]?
inEarnWin(int firstDay, int lastDay) =>
    not na(earnDay) and lastDay >= earnDay - earnWinMs and firstDay <= earnDay
barFirstDay = dayOf(time)
barLastDay  = dayOf(time_close - 1)   // − 1 ms: falls das Kerzenende als Mitternacht des Folgetags geliefert wird
// Kerze liegt im Sperrfenster, wenn einer ihrer Tage darin liegt (Daily wie Weekly).
earnSoon   = inEarnWin(barFirstDay, barLastDay)
earnBlock  = hideNearEarn and earnSoon
// Vergangene Earnings: Kerze, auf der TradingView die neuen Zahlen liefert.
pastEarn   = request.earnings(syminfo.tickerid, earnings.actual, gaps = barmerge.gaps_on, lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
earnBar    = not na(pastEarn)

// Farbe für das Sperrfenster vergangener Earnings, rückwirkend k Kerzen vor der Earnings-Kerze.
// Im Monthly-Chart kein Grau: bei Quartalszahlen wären sonst bis zu zwei von drei Monaten grau.
EARN_COL  = color.new(color.gray, 55)
earnBgOn  = showEarnBg and not isMonthly
pastEarnCol(int k) =>
    earnBgOn and earnBar and time_close[k] > time - earnWinMs ? EARN_COL : na

// ═══════════════════════════════════════════════════════════════════
// SETUP-LOGIK
// Zeigt nur, ob ein Setup besteht und wo Entry (Stop-Order) und SL lägen.
// Wird der Entry erreicht, endet das Setup – kein Trade-Management.
// ═══════════════════════════════════════════════════════════════════
var int   setupDir   = 0     // 0 = kein Setup, 1 = Long, -1 = Short
var int   setupStart = na
var float entryLvl   = na
var float slLvl      = na

bool evNewSetup  = false
bool evMoveSetup = false
int  evTrigDir   = 0         // Richtung des Setups, dessen Entry auf diesem Bar erreicht wurde

// 1) Offenes Setup: Zuerst Abbruch prüfen – Trigger weg, Earnings, Verfall stehen schon zur
//    Eröffnung fest (dann würde man die Order vor Handelsbeginn löschen). Danach: Entry erreicht?
//    Gaps ohne Auslösung zählen nicht.
if setupDir != 0
    trendLost = setupDir == 1 ? not longTrend : not shortTrend
    if trendLost or earnBlock or setupExpired(setupStart)
        setupDir := 0
    else if setupDir == 1 ? high >= entryLvl : low <= entryLvl
        evTrigDir := setupDir
        setupDir  := 0
// Close dieser Kerze ist der Gegentrigger: Setup endet sofort, nicht erst auf der Folgekerze.
if barstate.isconfirmed and setupDir != 0 and not (setupDir == 1 ? longNext : shortNext)
    setupDir := 0

// 2) Neues Setup: Trigger aktiv, rote (Long) / grüne (Short) Kerze, %R-Close im Extrembereich.
//    Nachziehen laut Guide: Solange das Setup offen ist, zieht jeder weitere Downday (Long)
//    bzw. Upday (Short) den Entry auf die neue Kerze nach.
//    SL: liegt immer unter dem tiefsten Tief (Long) bzw. über dem höchsten Hoch (Short) seit der
//    ersten Signalkerze – auch Kerzen ohne Signal ziehen ihn nach. Er wandert nie zurück in die Bewegung.
longSig  = tradeChart and inRange and enableLong  and longTrend  and longNext  and close < open and wr <= wrLongLvl  and not earnBlock
shortSig = tradeChart and inRange and enableShort and shortTrend and shortNext and close > open and wr >= wrShortLvl and not earnBlock
moveSig  = setupDir == 1 ? close < open : setupDir == -1 ? close > open : false

if barstate.isconfirmed and evTrigDir == 0
    newDir = setupDir != 0 ? (moveSig ? setupDir : 0) : longSig ? 1 : shortSig ? -1 : 0
    if newDir != 0
        barSl = newDir == 1 ? bufLevel(low, -1) : bufLevel(high, 1)
        if setupDir == 0
            evNewSetup := true
            setupStart := bar_index
            slLvl      := barSl
        else
            evMoveSetup := true
            slLvl      := newDir == 1 ? math.min(slLvl, barSl) : math.max(slLvl, barSl)
        setupDir := newDir
        entryLvl := newDir == 1 ? bufLevel(high, 1) : bufLevel(low, -1)
    else if setupDir != 0
        // Kerze ohne Signal (Long: grün, Short: rot): Entry bleibt, SL folgt einem neuen Extrem der Bewegung.
        barSl = setupDir == 1 ? bufLevel(low, -1) : bufLevel(high, 1)
        slLvl := setupDir == 1 ? math.min(slLvl, barSl) : math.max(slLvl, barSl)

// 3) Risiko-Filter: prozentuales Risiko = |Entry − SL| / Entry. Filtert nur die Anzeige (Linien, Marker,
//    Hervorhebung, Alerts, Screener) – das Setup läuft intern weiter, da sich das Risiko beim Nachziehen ändert.
hasLvls  = setupDir != 0 or evTrigDir != 0
riskPct  = hasLvls ? math.abs(entryLvl - slLvl) / entryLvl * 100 : na
riskOk   = not riskFilter or (riskPct >= riskMin and riskPct <= riskMax)

// ═══════════════════════════════════════════════════════════════════
// FAIR VALUE GAPS (Issue #18) – nur im Trade-Chart. Immer berechnet (auch bei Filter aus), damit die
// Screener-Spalte „FVG im Gewinnbereich (1 / 0)“ unabhängig von der Filter-Einstellung gefüllt ist.
// Gemerkt werden nur ungefüllte FVGs (meist wenige) → keine Performance-Probleme trotz langer Rückschau.
// Höhere TFs: Werte der zuletzt ABGESCHLOSSENEN Kerze ([1] + lookahead, kein Repainting); ein Weekly-FVG
// steht also ab der ersten Kerze der Folgewoche fest. Gefüllt wird mit den Kerzen des Charts.
// ═══════════════════════════════════════════════════════════════════
fvgOn     = tradeChart
chartTfId = is4h ? 0 : isDaily ? 1 : isWeekly ? 2 : 3
// Kerzen der höheren TFs kommen aus den gemeinsamen Abrufen oben (Abschnitt INDIKATOREN & TREND).
dNew = not na(dT) and (na(dT[1]) or dT != dT[1])     // neue Daily-Kerze abgeschlossen
wNew = not na(wT) and (na(wT[1]) or wT != wT[1])     // neue Weekly-Kerze abgeschlossen
mNew = not na(mT) and (na(mT[1]) or mT != mT[1])     // neue Monthly-Kerze abgeschlossen

var fvgBull  = array.new<Fvg>()   // bullisch, absteigend nach top
var fvgBear  = array.new<Fvg>()   // bärisch, aufsteigend nach bot
var fvgQ4h   = array.new<Fvg>()   // Ablauf-Warteschlangen je TF (Entstehungsreihenfolge)
var fvgQD    = array.new<Fvg>()
var fvgQW    = array.new<Fvg>()
var fvgQM    = array.new<Fvg>()
var int fvgAlive = 0              // Anzahl offener FVGs
var int dCnt = 0
var int wCnt = 0
var int mCnt = 0
FVG_MAX = 1500   // ab dieser Listenlänge erledigte Einträge aufräumen

if fvgOn and barstate.isconfirmed
    // 1) Neue FVGs der höheren TFs
    if dNew
        dCnt += 1
        if chartTfId < 1 and fvgUseD and not na(dH2)
            fvgAlive += fvgAdd(fvgBull, fvgBear, fvgQD, 1, dH, dL, dH2, dL2, dT2, dCnt)
    if wNew
        wCnt += 1
        if chartTfId < 2 and fvgUseW and not na(wH2)
            fvgAlive += fvgAdd(fvgBull, fvgBear, fvgQW, 2, wH, wL, wH2, wL2, wT2, wCnt)
    if mNew
        mCnt += 1
        if chartTfId < 3 and fvgUseM and not na(mH2)
            fvgAlive += fvgAdd(fvgBull, fvgBear, fvgQM, 3, mH, mL, mH2, mL2, mT2, mCnt)
    // 2) Rückschau abgelaufen → erledigt (Alter wie bisher: Chart-TF in Kerzen, höhere TFs über ihre Zähler)
    fvgAlive -= fvgExpire(fvgQ4h, bar_index, fvgLb4h)
    fvgAlive -= fvgExpire(fvgQD, chartTfId == 1 ? bar_index : dCnt, fvgLbD)
    fvgAlive -= fvgExpire(fvgQW, chartTfId == 2 ? bar_index : wCnt, fvgLbW)
    fvgAlive -= fvgExpire(fvgQM, mCnt, fvgLbM)
    // 3) Komplett gefüllt → erledigt; teilweise gefüllt → Rest verkleinern (nur die vorderen FVGs betroffen)
    fvgAlive -= fvgFill(fvgBull, true, low, high)
    fvgAlive -= fvgFill(fvgBear, false, low, high)
    // 4) Neues FVG im Chart-TF (diese Kerze ist die jüngste der drei)
    chartUse = chartTfId == 0 ? fvgUse4h : chartTfId == 1 ? fvgUseD : fvgUseW
    chartQ   = chartTfId == 0 ? fvgQ4h : chartTfId == 1 ? fvgQD : fvgQW
    if chartUse and bar_index >= 2
        fvgAlive += fvgAdd(fvgBull, fvgBear, chartQ, chartTfId, high, low, high[2], low[2], time[2], bar_index)
    if fvgBull.size() > FVG_MAX
        fvgCompact(fvgBull)
    if fvgBear.size() > FVG_MAX
        fvgCompact(fvgBear)

// Liegt ein gegenläufiges FVG im Gewinnbereich [Entry, Ziel 1:1]? (jede Überlappung zählt)
// Sortierte Listen: Long prüft bärische ab dem nächsten über dem Kurs, Short bullische ab dem nächsten darunter;
// Abbruch, sobald ein FVG jenseits der Zone beginnt.
bool fvgHitCalc = false
if setupDir != 0 and fvgAlive > 0
    r   = math.abs(entryLvl - slLvl)
    zLo = setupDir == 1 ? entryLvl : entryLvl - r
    zHi = setupDir == 1 ? entryLvl + r : entryLvl
    hitList = setupDir == 1 ? fvgBear : fvgBull
    for f in hitList
        if setupDir == 1 ? f.bot >= zHi : f.top <= zLo
            break
        if not f.dead and f.bot < zHi and f.top > zLo
            fvgHitCalc := true
            break
// Kerze, auf der der Entry erreicht wird: Zustand des Setups von der Vorkerze (als die Order lag).
fvgInZone = setupDir != 0 ? fvgHitCalc : evTrigDir != 0 ? fvgHitCalc[1] : false   // gemessen, immer
fvgHit    = fvgFilter and fvgInZone                                                // wirkt nur mit Filter
setupOk   = riskOk and not fvgHit

// ═══════════════════════════════════════════════════════════════════
// PINE SCREENER – diese Plots MÜSSEN die ersten plot()-Aufrufe im Skript bleiben!
// Der Screener übernahm „Setup-Status“ nicht mehr, nachdem weitere Plots (MAs) davor standen.
// Filtert nach Plot-Werten der jüngsten Kerze: offenes, gültiges Setup?
// 1 = Long, -1 = Short, 0 = keins. Entry erreicht, Trigger weg, Earnings-Sperre oder Risiko außerhalb → 0.
// ACHTUNG: Im Pine Screener ist earnings.future_time leer – dort greift die Earnings-Sperre NICHT.
// Bewusst keine Schätzung des Termins (vom Nutzer so entschieden); Treffer im Chart prüfen.
// ═══════════════════════════════════════════════════════════════════
scrActive = setupDir != 0 and setupOk
plot(scrActive ? setupDir : 0, "Setup-Status (1 Long / -1 Short / 0)", display = display.data_window)
plot(scrActive ? entryLvl : na, "Setup Entry", display = display.data_window)
plot(scrActive ? slLvl : na, "Setup SL", display = display.data_window)
plot(setupDir != 0 ? riskPct : na, "Setup Risiko (%)", display = display.data_window)
// Diagnose: Tage bis zu den nächsten Earnings (leer = TradingView liefert keinen Termin).
plot(daysToEarn, "Tage bis Earnings", display = display.data_window)

// ═══════════════════════════════════════════════════════════════════
// DARSTELLUNG – Bollinger-Bänder & Trend
// ═══════════════════════════════════════════════════════════════════
plot(showBB ? basis : na, "BB Mid",   color.new(color.gray, 20), bbWidth)
pBbUpper = plot(showBB ? upper : na, "BB Upper", color.new(color.blue, 40), bbWidth)
pBbLower = plot(showBB ? lower : na, "BB Lower", color.new(color.red, 40), bbWidth)
// Füllung zwischen den Bändern (Issue #15): sehr leichtes Grau, deutlich schwächer als Trigger- und Earnings-Hintergrund.
fill(pBbUpper, pBbLower, bbFillOn ? bbFillCol : na, "BB Füllung")

// Moving Averages (unabhängig von der Setup-Logik, nur zur Orientierung)
maStyle = maStyleIn == "Gestrichelt" ? plot.linestyle_dashed : maStyleIn == "Gepunktet" ? plot.linestyle_dotted : plot.linestyle_solid
ma1 = maCalc(ma1Len)
ma2 = maCalc(ma2Len)
ma3 = maCalc(ma3Len)
ma4 = maCalc(ma4Len)
// Plot-Titel müssen konstant sein – sie nennen die Standardlänge (bei geänderter Länge nicht mehr exakt).
plot(maShow and ma1On ? ma1 : na, "MA 20", ma1Col, maWidth, linestyle = maStyle)
plot(maShow and ma2On ? ma2 : na, "MA 50", ma2Col, maWidth, linestyle = maStyle)
plot(maShow and ma3On ? ma3 : na, "MA 150", ma3Col, maWidth, linestyle = maStyle)
plot(maShow and ma4On ? ma4 : na, "MA 200", ma4Col, maWidth, linestyle = maStyle)

bgLong  = bgMode == "Trigger" ? longTrend  : bgMode == "Weekly-Trend" and htfState == 1
bgShort = bgMode == "Trigger" ? shortTrend : bgMode == "Weekly-Trend" and htfState == -1
bgcolor(bgLong  ? bgLongCol  : na, title = "Long-Trigger Zone")
bgcolor(bgShort ? bgShortCol : na, title = "Short-Trigger Zone")

// Hintergrund der nächsten Kerze vorab zeigen: Sie existiert noch nicht, darum per offset = 1 rechts der
// jüngsten Kerze. Sobald sie da ist, übernimmt der normale Hintergrund. Nach Handelsschluss ohne neuen Tick
// ist die Kerze evtl. noch nicht „confirmed“, darum zusätzlich die Uhrzeit.
regNow  = bgLong ? 1 : bgShort ? -1 : 0
regNext = bgMode == "Aus" ? 0 : not tradeChart ? (trigChart ? chartStateNext : 0) : bgMode == "Trigger" ? (longNext ? 1 : shortNext ? -1 : 0) : htfNext
regBarDone = barstate.islast and (barstate.isconfirmed or timenow >= time_close)
regShow    = regNextShow and tfValid and bgMode != "Aus" and regBarDone
regChange  = regShow and regNext != regNow
regSame    = regShow and regNextSame and regNext == regNow and regNext != 0
regBgCol   = regChange ? (regNext == 1 ? regNextLongCol : regNext == -1 ? regNextShortCol : regNextNoneCol) : regSame ? (regNext == 1 ? bgLongCol : bgShortCol) : na
bgcolor(regBgCol, offset = 1, title = "Regimewechsel nächste Kerze")

// Earnings-Sperrfenster grau (über dem Trigger-Hintergrund).
// Aktueller Termin: direkt. Vergangene Termine: rückwirkend per Offset (max. 16 Kerzen ≈ 21 Kalendertage).
bgcolor(earnBgOn and earnSoon ? EARN_COL : na, title = "Earnings-Sperrfenster")
// Nächste Kerze (noch nicht vorhanden): Termin und Dauer geschätzt, Feiertage unberücksichtigt. Grau liegt wie bei
// den normalen Kerzen über der Regime-Farbe.
// 4h: Die nächste Kerze liegt am selben Tag, außer nach der letzten Kerze der Sitzung.
nextBarShift = (isWeekly ? 7 : timeframe.isintraday and not session.islastbar_regular ? 0 : dayofweek == dayofweek.friday ? 3 : 1) * DAY_MS
earnNextBar  = inEarnWin(barFirstDay + nextBarShift, barLastDay + nextBarShift)
bgcolor(regNextShow and regBarDone and earnBgOn and earnNextBar ? EARN_COL : na, offset = 1, title = "Earnings-Sperrfenster nächste Kerze")
bgcolor(pastEarnCol(0),  offset = 0,   editable = false)
bgcolor(pastEarnCol(1),  offset = -1,  editable = false)
bgcolor(pastEarnCol(2),  offset = -2,  editable = false)
bgcolor(pastEarnCol(3),  offset = -3,  editable = false)
bgcolor(pastEarnCol(4),  offset = -4,  editable = false)
bgcolor(pastEarnCol(5),  offset = -5,  editable = false)
bgcolor(pastEarnCol(6),  offset = -6,  editable = false)
bgcolor(pastEarnCol(7),  offset = -7,  editable = false)
bgcolor(pastEarnCol(8),  offset = -8,  editable = false)
bgcolor(pastEarnCol(9),  offset = -9,  editable = false)
bgcolor(pastEarnCol(10), offset = -10, editable = false)
bgcolor(pastEarnCol(11), offset = -11, editable = false)
bgcolor(pastEarnCol(12), offset = -12, editable = false)
bgcolor(pastEarnCol(13), offset = -13, editable = false)
bgcolor(pastEarnCol(14), offset = -14, editable = false)
bgcolor(pastEarnCol(15), offset = -15, editable = false)

// Earnings-Linie im Daily und 4h: schließt das Sperrfenster rechts ab (vergangene Termine + kommender Termin im Fenster).
earnVLine(int t) =>
    line.new(t, close, t, close * 1.01, xloc = xloc.bar_time, extend = extend.both, color = earnLineCol, width = earnLineW)

earnLineTf = isDaily or (isDH and is4h)   // 4h nur in D + 4h (W + D unverändert)
if earnLineShow and earnLineTf and earnBar and barstate.isconfirmed
    earnVLine(time)
var line earnNextLine = na
if barstate.islast
    line.delete(earnNextLine)
    earnNextLine := na
    if earnLineShow and earnLineTf and earnSoon and not earnBar
        earnNextLine := earnVLine(int(nextEarn))

// Trendwechsel des übergeordneten TF (W bzw. M; nur für Alerts – im Chart zeigt der Hintergrund die Grenze)
weeklyUpEdge   = htfState == 1  and htfState[1] != 1
weeklyDownEdge = htfState == -1 and htfState[1] != -1

// ═══════════════════════════════════════════════════════════════════
// DARSTELLUNG – Setup (nur Linien, inkl. des Bars, auf dem der Entry erreicht wird)
// ═══════════════════════════════════════════════════════════════════
showLvls = hasLvls and setupOk
plot(showLvls ? entryLvl : na, "Entry (Stop-Order)", color.blue, 2, plot.style_linebr)
plot(showLvls ? slLvl : na, "Stop-Loss", color.red, 1, plot.style_linebr)

// Marker auf der Signalkerze (neues Setup oder nachgezogen): gefülltes Label mit Spitze zur Kerze,
// weißer fetter Text L = Long (unter der Kerze) / S = Short (darüber). Feste Größe unabhängig vom Zoom.
// Die Marker des jüngsten Setups werden gemerkt, um sie beim aktuellen Setup umzufärben.
var array<label> lastMarks = array.new<label>()
var int          marksDir  = 0
sigBar = (evNewSetup or evMoveSetup) and setupOk
if evNewSetup
    array.clear(lastMarks)
    marksDir := setupDir
if sigBar and setupDir == 1
    array.push(lastMarks, label.new(bar_index, low, "L", yloc = yloc.belowbar, style = label.style_label_up, color = sigLongCol, textcolor = color.white, size = sigSize, text_formatting = text.format_bold))
if sigBar and setupDir == -1
    array.push(lastMarks, label.new(bar_index, high, "S", yloc = yloc.abovebar, style = label.style_label_down, color = sigShortCol, textcolor = color.white, size = sigSize, text_formatting = text.format_bold))

// ═══════════════════════════════════════════════════════════════════
// DARSTELLUNG – Aktuelles Setup hervorheben (nur auf der jüngsten Kerze bekannt)
// Hintergrund rückwirkend per Offset ab der ersten Signalkerze (max. 10 Kerzen) + Label rechts.
// ═══════════════════════════════════════════════════════════════════
curActive = hlCurrent and barstate.islast and setupDir != 0 and setupOk
curCol    = setupDir == 1 ? hlLongCol : hlShortCol
curSetupCol(int k) =>
    curActive and bar_index - k >= setupStart ? curCol : na

bgcolor(curSetupCol(0), offset = 0,  title = "Aktuelles Setup")
bgcolor(curSetupCol(1), offset = -1, editable = false)
bgcolor(curSetupCol(2), offset = -2, editable = false)
bgcolor(curSetupCol(3), offset = -3, editable = false)
bgcolor(curSetupCol(4), offset = -4, editable = false)
bgcolor(curSetupCol(5), offset = -5, editable = false)
bgcolor(curSetupCol(6), offset = -6, editable = false)
bgcolor(curSetupCol(7), offset = -7, editable = false)
bgcolor(curSetupCol(8), offset = -8, editable = false)
bgcolor(curSetupCol(9), offset = -9, editable = false)

var label curLbl = na
if barstate.islast
    // Marker des jüngsten Setups: Farbe der Hervorhebung, solange es aktuell ist, sonst normal.
    markCol = curActive ? color.new(curCol, 0) : marksDir == 1 ? sigLongCol : sigShortCol
    for m in lastMarks
        label.set_color(m, markCol)
    label.delete(curLbl)
    curLbl := na
    if curActive
        curTxt = (setupDir == 1 ? "LONG-SETUP" : "SHORT-SETUP") + "\nEntry " + str.tostring(entryLvl, format.mintick) + "\nSL " + str.tostring(slLvl, format.mintick) + "\nR: " + str.tostring(riskPct, "0.0") + " %"
        curLbl := label.new(bar_index, entryLvl, curTxt, style = label.style_label_left, color = color.new(curCol, 0), textcolor = color.white, size = size.normal, text_formatting = text.format_bold)

// Entry/SL des aktuellen Setups zusätzlich als Text in den Pine Logs (Pine-Editor → Pine Logs), zum Kopieren –
// Label-Text lässt sich in TradingView nicht markieren. Nur bei Änderung, nicht bei jedem Tick.
var string setupLogged = na
if barstate.islast and setupDir != 0 and setupOk
    logTxt = syminfo.ticker + " " + (setupDir == 1 ? "LONG" : "SHORT") + ": Entry " + str.tostring(entryLvl, format.mintick) + " / SL " + str.tostring(slLvl, format.mintick) + " / R " + str.tostring(riskPct, "0.0") + " %"
    if logTxt != setupLogged
        log.info(logTxt)
        setupLogged := logTxt

// ═══════════════════════════════════════════════════════════════════
// ZUSATZINFOS – All-Time High
// Monatsdaten liefern die gesamte Historie (auch vor den im Chart geladenen Kerzen),
// die Chart-Kerzen ergänzen den laufenden Monat.
// ═══════════════════════════════════════════════════════════════════
athMonthly = mAth   // aus dem gemeinsamen Monats-Abruf (Abschnitt INDIKATOREN & TREND)
athChart   = ta.max(high)
ath        = math.max(nz(athMonthly, athChart), athChart)

ATH_LBL_OFFSET = 5   // Kerzen rechts der jüngsten Kerze
var line  athLine = na
var label athLbl  = na
if barstate.islast
    line.delete(athLine)
    label.delete(athLbl)
    athLine := na
    athLbl  := na
    if athShow
        athLine := line.new(bar_index - 1, ath, bar_index, ath, extend = extend.both, color = athCol, width = athWidth)
        // Label rechts neben der jüngsten Kerze (etwas versetzt, damit es nicht am Label des aktuellen Setups klebt).
        // Bewusst NICHT mehr am linken sichtbaren Rand: chart.left_visible_bar_time zwingt TradingView, den ganzen
        // Indikator bei jedem Scrollen/Zoomen neu zu berechnen (Issue #21).
        athLbl  := label.new(bar_index + ATH_LBL_OFFSET, ath, "All-Time High " + str.tostring(ath, format.mintick), style = label.style_label_left, color = athCol, textcolor = color.black, size = size.normal, text_formatting = text.format_bold)

// ═══════════════════════════════════════════════════════════════════
// ZUSATZINFOS – Sektor / Industrie / Sektor-ETF (kompakte Tabelle oben Mitte; unten überlappt sie mit dem Volumen)
// Sektor und Industrie: TradingView-Daten. Sektor-ETF: eigene Näherung, vorsichtig als „(evtl. XLY)“ –
// Select Sector SPDRs enthalten nur S&P-500-Aktien, die Mitgliedschaft liefert Pine aber nicht.
// Keine Börse/Index: syminfo.prefix ist die Datenquelle (z. B. BATS), nicht die Heimatbörse; Index-Mitgliedschaft
// gibt es in Pine nicht (Listen im Code verworfen – zu groß, Pflegeaufwand).
// ═══════════════════════════════════════════════════════════════════
// Zeile 0 = unsichtbarer Abstandshalter (Höhe einstellbar), damit die Tabelle unter der Statuszeile steht –
// Pine kennt nur feste Tabellenpositionen, keine Pixel-Abstände.
SYM_BG = color.new(color.gray, 85)
var table symTbl = table.new(position.top_center, 3, 2, border_width = 0)
if symInfoShow and barstate.islast
    sec    = na(syminfo.sector) ? "" : syminfo.sector
    ind    = na(syminfo.industry) ? "" : syminfo.industry
    etf    = syminfo.currency == "USD" ? sectorEtf(sec, ind) : "–"
    table.cell(symTbl, 0, 0, "", height = symInfoGap)
    table.merge_cells(symTbl, 0, 0, 2, 0)
    table.cell(symTbl, 0, 1, sec == "" ? "–" : sec, bgcolor = SYM_BG, text_color = chart.fg_color, text_size = size.small, tooltip = "Sektor (TradingView)")
    table.cell(symTbl, 1, 1, ind == "" ? "–" : ind, bgcolor = SYM_BG, text_color = chart.fg_color, text_size = size.small, tooltip = "Industrie (TradingView)")
    table.cell(symTbl, 2, 1, etf == "–" ? "–" : "(evtl. " + etf + ")", bgcolor = SYM_BG, text_color = color.new(chart.fg_color, 30), text_size = size.small, tooltip = "Sektor-ETF (Select Sector SPDR) – eigene Näherung aus dem TradingView-Sektor. Gilt nur, falls die Aktie im S&P 500 ist; das liefert Pine nicht.")

// Nur im Datenfenster sichtbar (zur Kontrolle, was der Indikator je Bar sieht)
plot(htfState, "Trend übergeordnet W bzw. M (1 / -1)", display = display.data_window)
plot(ltfState, "Trend Trade-TF D bzw. W (1 / -1)", display = display.data_window)
plot(wrClosed, "Williams %R (abgeschl. Kerze)", display = display.data_window)
plot(fvgOn ? fvgAlive : na, "Offene FVGs (Anzahl)", display = display.data_window)
plot(fvgOn and hasLvls ? (fvgInZone ? 1 : 0) : na, "FVG im Gewinnbereich (1 / 0)", display = display.data_window)

// ═══════════════════════════════════════════════════════════════════
// ZUSATZINFOS – Offene FVGs als Kästen (nur zur Kontrolle, Default aus), nächste am Kurs zuerst, max. 400
// ═══════════════════════════════════════════════════════════════════
var array<box> fvgBoxes = array.new<box>()
if barstate.islast
    for b in fvgBoxes
        box.delete(b)
    array.clear(fvgBoxes)
    if fvgShow and fvgOn and fvgAlive > 0
        // Abwechselnd bullisch (unter dem Kurs) und bärisch (darüber), jeweils vom Kurs weg.
        for k = 0 to math.max(fvgBull.size(), fvgBear.size()) - 1
            if k < fvgBull.size() and fvgBoxes.size() < 400
                fvgBox(fvgBoxes, fvgBull.get(k))
            if k < fvgBear.size() and fvgBoxes.size() < 400
                fvgBox(fvgBoxes, fvgBear.get(k))
            if fvgBoxes.size() >= 400
                break
// Hinweis, wenn nicht alle offenen FVGs gezeichnet werden (Grenze 400 Kästen): unten rechts, nur dann sichtbar.
var table fvgCapTbl = table.new(position.bottom_right, 1, 1, border_width = 0)
if barstate.islast
    table.clear(fvgCapTbl, 0, 0)
    if fvgShow and fvgOn and fvgAlive > array.size(fvgBoxes)
        table.cell(fvgCapTbl, 0, 0, "FVG-Anzeige: " + str.tostring(array.size(fvgBoxes)) + " von " + str.tostring(fvgAlive) + " (die nächsten am Kurs)", bgcolor = color.new(color.gray, 85), text_color = color.orange, text_size = size.small, tooltip = "Der Indikator zeichnet höchstens 400 FVG-Kästen (TradingView erlaubt pro Skript max. 500 Kästen). Gezeichnet werden die dem Kurs nächstgelegenen. Der FVG-Filter prüft trotzdem alle offenen FVGs.")

// ═══════════════════════════════════════════════════════════════════
// STATUS-TABELLE
// ═══════════════════════════════════════════════════════════════════
var table tbl = table.new(position.top_right, 2, 7, bgcolor = color.new(color.gray, 85), border_width = 1)
if showTable and barstate.islast
    statusTxt = setupDir == 0 ? "Kein Setup" : (setupDir == 1 ? "Long-Setup" : "Short-Setup") + (not riskOk ? " (Risiko außerhalb)" : fvgHit ? " (FVG im Gewinnbereich)" : "")
    lvlTxt    = setupDir != 0 ? str.tostring(entryLvl, format.mintick) + " / SL " + str.tostring(slLvl, format.mintick) + " / R " + str.tostring(riskPct, "0.0") + " %" : "–"
    earnTxt   = na(nextEarn) ? "keine Daten" : str.format_time(int(nextEarn), "dd.MM.yyyy", syminfo.timezone) + " (" + str.tostring(math.ceil(daysToEarn)) + " T)"
    table.cell(tbl, 0, 0, "Trend " + htfTf, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 0, trendTxt(htfState), text_color = trendCol(htfState), text_size = size.small)
    table.cell(tbl, 0, 1, "Trend " + ltfName, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 1, tradeChart ? trendTxt(ltfState) : "–", text_color = trendCol(ltfState), text_size = size.small)
    table.cell(tbl, 0, 2, "Williams %R", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 2, str.tostring(wrClosed, "0.0"), text_color = wrClosed <= wrLongLvl ? color.green : wrClosed >= wrShortLvl ? color.red : chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 3, "Status", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 3, statusTxt, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 4, "Entry / SL", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 4, lvlTxt, text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 0, 5, "Earnings", text_color = chart.fg_color, text_size = size.small)
    table.cell(tbl, 1, 5, earnTxt, text_color = earnSoon ? color.orange : chart.fg_color, text_size = size.small)
    if not tfValid
        table.cell(tbl, 0, 6, "⚠", text_color = color.orange, text_size = size.small)
        table.cell(tbl, 1, 6, "Spielweise " + playMode + ": nur " + (isMW ? "Weekly- und Monthly-Chart" : isDH ? "4h-, Daily-, Weekly- und Monthly-Chart" : "Daily-, Weekly- und Monthly-Chart"), text_color = color.orange, text_size = size.small)

// ═══════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════
alertcondition(weeklyUpEdge, "Weekly UP", "{{ticker}}: Weekly-Trend UP")
alertcondition(weeklyDownEdge, "Weekly DOWN", "{{ticker}}: Weekly-Trend DOWN")
// Entry/SL als Text in der Alert-Nachricht (Platzhalter {{plot("…")}} greifen auf die Screener-Plots zu):
// die Nachricht ist im Alert-Protokoll, Popup, Push oder E-Mail kopierbar – Pine-Labels sind es nicht.
alertcondition(sigBar and setupDir == 1, "Long-Setup", '{{ticker}}: Long-Setup – Stop-Buy {{plot("Setup Entry")}}, SL {{plot("Setup SL")}}, Risiko {{plot("Setup Risiko (%)")}} %')
alertcondition(sigBar and setupDir == -1, "Short-Setup", '{{ticker}}: Short-Setup – Stop-Sell {{plot("Setup Entry")}}, SL {{plot("Setup SL")}}, Risiko {{plot("Setup Risiko (%)")}} %')
alertcondition(evTrigDir == 1 and setupOk, "Long-Entry erreicht", "{{ticker}}: Long-Entry erreicht")
alertcondition(evTrigDir == -1 and setupOk, "Short-Entry erreicht", "{{ticker}}: Short-Entry erreicht")
